<configuration>
  <packageSources>
    <!-- Deja las fuentes por defecto de NuGet -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    
    <!-- Agrega tu fuente de GitHub con tu usuario JorgeMadri -->
