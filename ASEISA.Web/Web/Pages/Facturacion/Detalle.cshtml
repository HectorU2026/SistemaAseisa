@page "{idFactura:int}"
@model Web.Pages.Facturacion.DetalleModel

@{
    ViewData["Title"] = "Detalle de factura";
    var factura = Model.Factura;
    var esContador = User.IsInRole("Contador");
    var puedeConfirmar = factura is not null
        && esContador
        && string.Equals(factura.Estado, "Borrador", StringComparison.Ordinal);
    var puedeRestablecer = factura is not null
        && esContador
        && string.Equals(factura.Estado, "Emitida", StringComparison.Ordinal);
    var versionFila = factura?.VersionFila is { Length: 8 }
        ? Convert.ToBase64String(factura.VersionFila)
        : string.Empty;
}

<link rel="stylesheet" href="~/css/contactos.css" asp-append-version="true" />

<div class="contactos-page">
    <div class="contactos-header">
        <div>
            <div class="contactos-breadcrumb">
                <i class="bi bi-receipt" aria-hidden="true"></i>
                <a asp-page="/Facturacion/Listado">Facturación</a>
                <span>/ Detalle</span>
            </div>
            <h1>@(factura?.NumeroFactura ?? "Detalle de factura")</h1>
            <p>Consulte la información de la factura de su empresa.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @if (puedeConfirmar)
            {
                <button type="button"
                        class="btn btn-contacto-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#modalConfirmarFactura">
                    Confirmar factura
                </button>
            }
            @if (puedeRestablecer)
            {
                <button type="button"
                        class="btn btn-contacto-outline"
                        data-bs-toggle="modal"
                        data-bs-target="#modalRestablecerFactura">
                    Restablecer factura
                </button>
            }
            <a asp-page="/Facturacion/Listado" class="btn btn-contacto-outline">
                Volver al listado
            </a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.MensajeExito))
    {
        <div class="alert alert-success" role="alert">
            <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>
            @Model.MensajeExito
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.MensajeError))
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>
            @Model.MensajeError
        </div>
    }

    @if (factura is not null)
    {
        <section class="contactos-panel mb-4">
            <div class="contactos-panel-header">
                <div>
                    <h2>Información general</h2>
                    <p>@factura.Estado</p>
                </div>
            </div>
            <div class="row g-3 px-4 pb-4">
                <div class="col-md-4">
                    <span class="text-muted small d-block">Número de factura</span>
                    <strong>@factura.NumeroFactura</strong>
                </div>
                <div class="col-md-4">
                    <span class="text-muted small d-block">Comprobante</span>
                    <strong>@(string.IsNullOrWhiteSpace(factura.NumeroComprobante) ? "—" : factura.NumeroComprobante)</strong>
                </div>
                <div class="col-md-4">
                    <span class="text-muted small d-block">Tipo de factura</span>
                    <strong>@(string.IsNullOrWhiteSpace(factura.TipoFactura) ? "—" : factura.TipoFactura)</strong>
                </div>
                <div class="col-md-4">
                    <span class="text-muted small d-block">Estado</span>
                    <strong>@factura.Estado</strong>
                </div>
                <div class="col-md-4">
                    <span class="text-muted small d-block">Fecha de emisión</span>
                    <strong>@factura.FechaEmision.ToString("dd/MM/yyyy")</strong>
                </div>
                <div class="col-md-4">
                    <span class="text-muted small d-block">Fecha de vencimiento</span>
                    <strong>@(factura.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "—")</strong>
                </div>
                @if (!string.IsNullOrWhiteSpace(factura.MotivoAnulacion))
                {
                    <div class="col-12">
                        <span class="text-muted small d-block">Motivo de anulación</span>
                        <strong>@factura.MotivoAnulacion</strong>
                    </div>
                }
            </div>
        </section>

        <section class="contactos-panel mb-4">
            <div class="contactos-panel-header">
                <div>
                    <h2>Cliente y condiciones</h2>
                    <p>Datos comerciales de la factura.</p>
                </div>
            </div>
            <div class="row g-3 px-4 pb-4">
                <div class="col-md-4">
                    <span class="text-muted small d-block">Cliente</span>
                    <strong>@factura.NombreCliente</strong>
                </div>
                <div class="col-md-4">
                    <span class="text-muted small d-block">Identificación</span>
                    <strong>@(string.IsNullOrWhiteSpace(factura.Identificacion) ? "—" : factura.Identificacion)</strong>
                </div>
                <div class="col-md-4">
                    <span class="text-muted small d-block">Correo</span>
                    <strong>@(string.IsNullOrWhiteSpace(factura.CorreoCliente) ? "—" : factura.CorreoCliente)</strong>
                </div>
                <div class="col-md-4">
                    <span class="text-muted small d-block">Condición de venta</span>
                    <strong>@(string.IsNullOrWhiteSpace(factura.CondicionVenta) ? "—" : factura.CondicionVenta)</strong>
                </div>
                <div class="col-md-4">
                    <span class="text-muted small d-block">Término de pago</span>
                    <strong>@(string.IsNullOrWhiteSpace(factura.TerminoPagoNombre) ? "—" : factura.TerminoPagoNombre)</strong>
                </div>
                <div class="col-md-2">
                    <span class="text-muted small d-block">Moneda</span>
                    <strong>@(string.IsNullOrWhiteSpace(factura.Moneda) ? "—" : factura.Moneda)</strong>
                </div>
                <div class="col-md-2">
                    <span class="text-muted small d-block">Tipo de cambio</span>
                    <strong>@(factura.TipoCambio?.ToString("N2") ?? "—")</strong>
                </div>
            </div>
        </section>

        <section class="contactos-panel mb-4">
            <div class="contactos-panel-header">
                <div>
                    <h2>Productos</h2>
                    <p>Líneas incluidas en la factura.</p>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table contactos-table align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Código</th>
                            <th scope="col">Producto</th>
                            <th scope="col" class="text-end">Cantidad</th>
                            <th scope="col" class="text-end">Precio</th>
                            <th scope="col" class="text-end">Descuento %</th>
                            <th scope="col" class="text-end">Impuesto %</th>
                            <th scope="col" class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (factura.Productos.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="contactos-empty text-center">
                                    <strong>Esta factura no tiene productos.</strong>
                                </td>
                            </tr>
                        }
                        @foreach (var producto in factura.Productos)
                        {
                            <tr>
                                <td>@producto.Codigo</td>
                                <td>@producto.Nombre</td>
                                <td class="text-end">@producto.Cantidad.ToString("N2")</td>
                                <td class="text-end">@producto.PrecioUnitario.ToString("N2")</td>
                                <td class="text-end">@(producto.PorcentajeDescuento?.ToString("N2") ?? "—")</td>
                                <td class="text-end">@(producto.PorcentajeImpuesto?.ToString("N2") ?? "—")</td>
                                <td class="text-end">@producto.Subtotal.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="row g-3 px-4 pb-4 justify-content-end">
                <div class="col-md-3 text-md-end">
                    <span class="text-muted small d-block">Subtotal</span>
                    <strong>@factura.Subtotal.ToString("N2")</strong>
                </div>
                <div class="col-md-3 text-md-end">
                    <span class="text-muted small d-block">Descuento</span>
                    <strong>@factura.Descuento.ToString("N2")</strong>
                </div>
                <div class="col-md-3 text-md-end">
                    <span class="text-muted small d-block">Impuesto</span>
                    <strong>@factura.Impuesto.ToString("N2")</strong>
                </div>
                <div class="col-md-3 text-md-end">
                    <span class="text-muted small d-block">Total</span>
                    <strong>@factura.Total.ToString("N2")</strong>
                </div>
                <div class="col-md-3 text-md-end">
                    <span class="text-muted small d-block">Saldo pendiente</span>
                    <strong>@factura.SaldoPendiente.ToString("N2")</strong>
                </div>
            </div>
        </section>

        @if (factura.Asiento is not null)
        {
            var asiento = factura.Asiento;
            <section class="contactos-panel mb-4">
                <div class="contactos-panel-header">
                    <div>
                        <h2>Asiento contable</h2>
                        <p>@asiento.NumeroAsiento · @asiento.FechaAsiento.ToString("dd/MM/yyyy") · @asiento.Estado</p>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(asiento.Descripcion) || !string.IsNullOrWhiteSpace(asiento.TipoOrigen))
                {
                    <p class="px-4">
                        @(string.IsNullOrWhiteSpace(asiento.TipoOrigen) ? "" : asiento.TipoOrigen)
                        @(string.IsNullOrWhiteSpace(asiento.Descripcion) ? "" : " · " + asiento.Descripcion)
                    </p>
                }
                <div class="table-responsive">
                    <table class="table contactos-table align-middle">
                        <thead>
                            <tr>
                                <th scope="col">Cuenta</th>
                                <th scope="col">Descripción</th>
                                <th scope="col" class="text-end">Debe</th>
                                <th scope="col" class="text-end">Haber</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (asiento.Movimientos.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" class="contactos-empty text-center">
                                        <strong>El asiento no tiene movimientos.</strong>
                                    </td>
                                </tr>
                            }
                            @foreach (var movimiento in asiento.Movimientos)
                            {
                                <tr>
                                    <td>@movimiento.Codigo - @movimiento.Nombre</td>
                                    <td>@(string.IsNullOrWhiteSpace(movimiento.Descripcion) ? "—" : movimiento.Descripcion)</td>
                                    <td class="text-end">@movimiento.Debe.ToString("N2")</td>
                                    <td class="text-end">@movimiento.Haber.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="row g-3 px-4 pb-4 justify-content-end">
                    <div class="col-md-3 text-md-end">
                        <span class="text-muted small d-block">Total debe</span>
                        <strong>@asiento.TotalDebe.ToString("N2")</strong>
                    </div>
                    <div class="col-md-3 text-md-end">
                        <span class="text-muted small d-block">Total haber</span>
                        <strong>@asiento.TotalHaber.ToString("N2")</strong>
                    </div>
                </div>
            </section>
        }
    }
</div>

@if (puedeConfirmar)
{
    <div class="modal fade"
         id="modalConfirmarFactura"
         tabindex="-1"
         aria-labelledby="modalConfirmarFacturaTitulo"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content contacto-modal">
                <div class="modal-body text-center">
                    <div class="contacto-modal-icono activar">
                        <i class="bi bi-check2-circle" aria-hidden="true"></i>
                    </div>
                    <h3 id="modalConfirmarFacturaTitulo">Confirmar factura</h3>
                    <p class="contacto-modal-descripcion">
                        ¿Está seguro de que desea confirmar esta factura? La factura pasará al estado Emitida.
                    </p>
                    <form method="post" asp-page-handler="Confirmar" data-cambio-estado>
                        <input type="hidden" name="versionFila" value="@versionFila" />
                        <div class="contacto-modal-acciones">
                            <button type="button"
                                    class="btn btn-contacto-outline"
                                    data-bs-dismiss="modal">
                                Cancelar
                            </button>
                            <button type="submit" class="btn btn-contacto-confirmar activar">
                                Confirmar factura
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@if (puedeRestablecer)
{
    <div class="modal fade"
         id="modalRestablecerFactura"
         tabindex="-1"
         aria-labelledby="modalRestablecerFacturaTitulo"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content contacto-modal">
                <div class="modal-body text-center">
                    <div class="contacto-modal-icono desactivar">
                        <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                    </div>
                    <h3 id="modalRestablecerFacturaTitulo">Restablecer factura</h3>
                    <p class="contacto-modal-descripcion">
                        ¿Está seguro de que desea restablecer esta factura? La factura volverá al estado Borrador.
                    </p>
                    <form method="post" asp-page-handler="Restablecer" data-cambio-estado>
                        <input type="hidden" name="versionFila" value="@versionFila" />
                        <div class="contacto-modal-acciones">
                            <button type="button"
                                    class="btn btn-contacto-outline"
                                    data-bs-dismiss="modal">
                                Cancelar
                            </button>
                            <button type="submit" class="btn btn-contacto-confirmar desactivar">
                                Restablecer factura
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@if (puedeConfirmar || puedeRestablecer)
{
    <script>
        document.querySelectorAll("[data-cambio-estado]").forEach(function (formulario) {
            formulario.addEventListener("submit", function () {
                window.setTimeout(function () {
                    var boton = formulario.querySelector("[type='submit']");
                    if (boton)
                        boton.disabled = true;
                }, 0);
            });
        });
    </script>
}
