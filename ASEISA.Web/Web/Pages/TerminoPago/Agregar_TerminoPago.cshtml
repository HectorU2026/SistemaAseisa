@page
@model Web.Pages.TerminoPago.Agregar_TerminoPagoModel

@{
    ViewData["Title"] = "Nuevo término de pago";
}

<link rel="stylesheet"
      href="~/css/contactos.css"
      asp-append-version="true" />

<div class="contactos-page">

    <div class="contactos-header">
        <div>
            <div class="contactos-breadcrumb">
                <i class="bi bi-credit-card"></i>
                <span>Configuración / Términos de pago / Nuevo</span>
            </div>

            <h1>Nuevo término de pago</h1>

            <p>
                Registre una nueva condición de pago
                para las operaciones de ASEISA.
            </p>
        </div>

        <a asp-page="/TerminoPago/Listado_TerminoPago"
           class="btn btn-contacto-outline">
            <i class="bi bi-arrow-left"></i>
            Volver al listado
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.MensajeError))
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @Model.MensajeError
        </div>
    }

    <section class="contactos-panel">

        <div class="contactos-panel-header">
            <div>
                <h2>Información del término</h2>
                <p>
                    Complete los datos para registrar
                    el nuevo término de pago.
                </p>
            </div>
        </div>

        <form method="post" class="p-4">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="row g-4">

                <div class="col-md-7">
                    <label asp-for="Termino.Nombre"
                           class="form-label fw-semibold">
                        Nombre del término
                        <span class="text-danger">*</span>
                    </label>

                    <input asp-for="Termino.Nombre"
                           class="form-control"
                           maxlength="100"
                           placeholder="Ejemplo: Crédito a 30 días" />

                    <span asp-validation-for="Termino.Nombre"
                          class="text-danger small"></span>

                    <div class="form-text">
                        Nombre con el que se identificará
                        este término de pago.
                    </div>
                </div>

                <div class="col-md-5">
                    <label asp-for="Termino.DiasCredito"
                           class="form-label fw-semibold">
                        Días de crédito
                        <span class="text-danger">*</span>
                    </label>

                    <input asp-for="Termino.DiasCredito"
                           type="number"
                           class="form-control"
                           min="0"
                           step="1"
                           placeholder="Ejemplo: 30" />

                    <span asp-validation-for="Termino.DiasCredito"
                          class="text-danger small"></span>

                    <div class="form-text">
                        Utilice 0 para pago inmediato.
                    </div>
                </div>

            </div>

            <div class="alert alert-info mt-4 mb-0">
                <i class="bi bi-info-circle-fill me-2"></i>
                Los términos de pago permiten establecer
                los plazos acordados con clientes y proveedores.
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">

                <a asp-page="/TerminoPago/Listado_TerminoPago"
                   class="btn btn-contacto-outline">
                    Cancelar
                </a>

                <button type="submit"
                        class="btn btn-contacto-primary"
                        id="btnGuardar">
                    <i class="bi bi-check-lg"></i>
                    Guardar término
                </button>

            </div>

        </form>

    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const formulario = document.querySelector("form[method='post']");
            const boton = document.getElementById("btnGuardar");

            if (!formulario || !boton) return;

            formulario.addEventListener("submit", function () {

                if (typeof $ !== "undefined" &&
                    $.validator &&
                    !$(formulario).valid()) {
                    return;
                }

                boton.disabled = true;
                boton.innerHTML =
                    '<span class="spinner-border spinner-border-sm me-2"></span>Guardando...';
            });
        });
    </script>
}
