@page
@using Abstracciones.Modelos
@model Web.Pages.Contacto.Detalle_ContactoModel

@{
    ViewData["Title"] = "Detalle del contacto";
}

<link rel="stylesheet"
      href="~/css/contactos.css"
      asp-append-version="true" />

<div class="contactos-page">

    <div class="contactos-header">
        <div>
            <div class="contactos-breadcrumb">
                <i class="bi bi-people"></i>
                <span>Contactos / Detalle</span>
            </div>

            <h1>Detalle del contacto</h1>
            <p>Consulte la información registrada del cliente o proveedor.</p>
        </div>

        <a asp-page="/Contacto/Listado_Contacto"
           class="btn btn-contacto-outline">
            <i class="bi bi-arrow-left"></i>
            Volver al listado
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.MensajeError))
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @Model.MensajeError
        </div>
    }

    @if (Model.Contacto is not null)
    {
        var contacto = Model.Contacto;

        <!-- RESUMEN DEL CONTACTO -->
        <section class="contacto-form-section">

            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">

                <div class="d-flex align-items-center gap-3">
                    <div class="contacto-avatar">
                        @(string.IsNullOrWhiteSpace(contacto.Nombre)
                            ? "?"
                            : contacto.Nombre[..1].ToUpper())
                    </div>

                    <div>
                        <h2 class="mb-1">@contacto.Nombre</h2>

                        <span class="contacto-tipo">
                            @contacto.RolContacto
                        </span>
                    </div>
                </div>

                <span class="contacto-estado @(contacto.Estado == "Activo" ? "activo" : "inactivo")">
                    <span class="estado-punto"></span>
                    @contacto.Estado
                </span>

            </div>

        </section>

        <!-- INFORMACIÓN GENERAL -->
        <section class="contacto-form-section">

            <div class="contacto-form-heading">
                <i class="bi bi-person-vcard"></i>
                <div>
                    <h2>Información general</h2>
                    <p>Datos de identificación y contacto.</p>
                </div>
            </div>

            <div class="row g-4">

                <div class="col-md-6">
                    <div class="text-muted small">Cédula</div>
                    <div class="fw-semibold">
                        @(string.IsNullOrWhiteSpace(contacto.Cedula)
                            ? "No registrada"
                            : contacto.Cedula)
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="text-muted small">Identificación fiscal</div>
                    <div class="fw-semibold">
                        @(string.IsNullOrWhiteSpace(contacto.IdentificacionFiscal)
                            ? "No registrada"
                            : contacto.IdentificacionFiscal)
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="text-muted small">Correo electrónico</div>
                    <div class="fw-semibold">@contacto.Correo</div>
                </div>

                <div class="col-md-6">
                    <div class="text-muted small">Teléfono</div>
                    <div class="fw-semibold">@contacto.Telefono</div>
                </div>

            </div>
        </section>

        <!-- UBICACIÓN -->
        <section class="contacto-form-section">

            <div class="contacto-form-heading">
                <i class="bi bi-geo-alt"></i>
                <div>
                    <h2>Ubicación y dirección</h2>
                    <p>Información geográfica del contacto.</p>
                </div>
            </div>

            <div class="row g-4">

                <div class="col-md-6">
                    <div class="text-muted small">País</div>
                    <div class="fw-semibold">@contacto.Pais</div>
                </div>

                <div class="col-md-6">
                    <div class="text-muted small">Provincia</div>
                    <div class="fw-semibold">
                        @(contacto.Provincia ?? "No registrada")
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="text-muted small">Cantón</div>
                    <div class="fw-semibold">
                        @(contacto.Canton ?? "No registrado")
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="text-muted small">Distrito</div>
                    <div class="fw-semibold">
                        @(contacto.Distrito ?? "No registrado")
                    </div>
                </div>

                <div class="col-12">
                    <div class="text-muted small">Dirección detallada</div>
                    <div class="fw-semibold">@contacto.DetalleDireccion</div>
                </div>

            </div>
        </section>

        <!-- CONFIGURACIÓN DE VENTAS -->
        @if (contacto.RolContacto == RolesContacto.Cliente ||
             contacto.RolContacto == RolesContacto.Ambos)
        {
            <section class="contacto-form-section">

                <div class="contacto-form-heading">
                    <i class="bi bi-cart-check"></i>
                    <div>
                        <h2>Configuración de ventas</h2>
                        <p>Condiciones comerciales como cliente.</p>
                    </div>
                </div>

                <div class="row g-4">

                    <div class="col-md-6">
                        <div class="text-muted small">Término de pago</div>
                        <div class="fw-semibold">
                            @(contacto.TerminoPagoVentas ?? "Sin asignar")
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="text-muted small">Método de pago</div>
                        <div class="fw-semibold">
                            @(contacto.MetodoPagoVentas ?? "Sin asignar")
                        </div>
                    </div>

                </div>
            </section>
        }

        <!-- CONFIGURACIÓN DE COMPRAS -->
        @if (contacto.RolContacto == RolesContacto.Proveedor ||
             contacto.RolContacto == RolesContacto.Ambos)
        {
            <section class="contacto-form-section">

                <div class="contacto-form-heading">
                    <i class="bi bi-truck"></i>
                    <div>
                        <h2>Configuración de compras</h2>
                        <p>Condiciones comerciales como proveedor.</p>
                    </div>
                </div>

                <div class="row g-4">

                    <div class="col-md-6">
                        <div class="text-muted small">Término de pago</div>
                        <div class="fw-semibold">
                            @(contacto.TerminoPagoCompras ?? "Sin asignar")
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="text-muted small">Método de pago</div>
                        <div class="fw-semibold">
                            @(contacto.MetodoPagoCompras ?? "Sin asignar")
                        </div>
                    </div>

                </div>
            </section>
        }

        <!-- INFORMACIÓN DEL REGISTRO -->
        <section class="contacto-form-section">

            <div class="contacto-form-heading">
                <i class="bi bi-clock-history"></i>
                <div>
                    <h2>Información del registro</h2>
                    <p>Fechas asociadas al contacto.</p>
                </div>
            </div>

            <div class="row g-4">

                <div class="col-md-6">
                    <div class="text-muted small">Fecha de registro</div>
                    <div class="fw-semibold">
                        @contacto.FechaRegistro.ToString("dd/MM/yyyy HH:mm")
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="text-muted small">Última modificación</div>
                    <div class="fw-semibold">
                        @(contacto.FechaModificacion.HasValue
                            ? contacto.FechaModificacion.Value.ToString("dd/MM/yyyy HH:mm")
                            : "Sin modificaciones")
                    </div>
                </div>

            </div>
        </section>

        <!-- ACCIONES -->
        <div class="contacto-form-actions">

            <a asp-page="/Contacto/Listado_Contacto"
               class="btn btn-contacto-outline">
                Volver
            </a>

            <a asp-page="/Contacto/Editar_Contacto"
               asp-route-idContacto="@contacto.IdContacto"
               class="btn btn-contacto-primary">
                <i class="bi bi-pencil"></i>
                Editar contacto
            </a>

        </div>
    }
</div>
