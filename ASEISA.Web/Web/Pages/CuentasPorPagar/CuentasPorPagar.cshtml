@page
@model Web.Pages.CuentasPorCobrar.CuentasPorPagarModel
@{
    ViewData["Title"] = "Cuentas por Pagar";
}

<link rel="stylesheet" href="~/css/cuentas_pagar.css" asp-append-version="true" />

<div class="container mt-4 mb-5 cxp-page">

    <!-- ENCABEZADO -->
    <div class="cxp-header">
        <div>
            <div class="cxp-breadcrumb">
                <i class="bi bi-bank"></i>
                <span>Finanzas / Cuentas por Pagar</span>
            </div>
            <h1>Cuentas por Pagar</h1>
            <p>Gestione las deudas y pagos pendientes con sus proveedores.</p>
        </div>
        <a href="/Menu" class="btn-cxp-outline shadow-sm">
            <i class="bi bi-arrow-left"></i> Volver al Menú
        </a>
    </div>

    <!-- FILTROS -->
    <form method="get" class="cxp-filtros">
        <div class="cxp-search">
            <i class="bi bi-search"></i>
            <input type="text" name="busqueda" value="@Request.Query["busqueda"]" placeholder="Buscar por proveedor o factura..." />
        </div>
        
        <select name="idEstado" class="form-select">
            <option value="">Todos los estados</option>
            <option value="1" selected="@(Request.Query["idEstado"] == "1")">Pendiente</option>
            <option value="2" selected="@(Request.Query["idEstado"] == "2")">Pagada</option>
            <option value="3" selected="@(Request.Query["idEstado"] == "3")">Vencida</option>
            <option value="4" selected="@(Request.Query["idEstado"] == "4")">Abono</option>
        </select>

        <input type="date" name="fecha" value="@Request.Query["fecha"]" class="form-control" title="Fecha de Vencimiento" />

        <button type="submit" class="btn-cxp-primary">
            <i class="bi bi-funnel"></i> Filtrar
        </button>
        
        <a href="/CuentasPorCobrar/CuentasPorPagar" class="btn-cxp-outline">Limpiar</a>
    </form>

    <!-- TABLA -->
    <div class="cxp-panel">
        <div class="table-responsive">
            <table class="table cxp-table align-middle">
                <thead>
                    <tr>
                        <th>Factura / Consecutivo</th>
                        <th>Proveedor</th>
                        <th>Emisión</th>
                        <th>Vencimiento</th>
                        <th class="text-end">Total</th>
                        <th class="text-end">Pendiente</th>
                        <th class="text-center">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Cuentas != null && Model.Cuentas.Any())
                    {
                        foreach (var item in Model.Cuentas)
                        {
                            // Asignamos la clase del badge según el estado
                            string badgeClass = "bg-pendiente";
                            if (item.Estado == "Pagada") badgeClass = "bg-pagada";
                            else if (item.Estado == "Vencida") badgeClass = "bg-vencida";
                            else if (item.Estado == "Abono") badgeClass = "bg-abono";

                            <tr>
                                <td class="fw-bold text-dark">@item.ConsecutivoFactura</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center text-secondary" style="width: 32px; height: 32px; background: #e2e8f0;">
                                            <i class="bi bi-building"></i>
                                        </div>
                                        <span class="fw-semibold text-secondary">@item.Proveedor</span>
                                    </div>
                                </td>
                                <td class="text-muted small">@item.FechaEmision.ToString("dd MMM, yyyy")</td>
                                <td class="text-muted small">@item.FechaVencimiento.ToString("dd MMM, yyyy")</td>
                                <td class="text-end fw-semibold">@item.MontoTotal.ToString("C")</td>
                                <td class="text-end fw-bold @(item.SaldoPendiente > 0 ? "text-danger" : "text-success")">
                                    @item.SaldoPendiente.ToString("C")
                                </td>
                                <td class="text-center">
                                    <span class="badge-cxp @badgeClass">@item.Estado</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-1 d-block mb-3" style="color: #b5bdc8;"></i>
                                <strong class="d-block mb-1">No hay cuentas por pagar</strong>
                                <span class="small">No existen registros que coincidan con los filtros.</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="cxp-footer">
            Mostrando @(Model.Cuentas?.Count ?? 0) registro(s).
        </div>
    </div>
</div>