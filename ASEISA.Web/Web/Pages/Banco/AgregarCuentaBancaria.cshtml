@page
@model Web.Pages.Banco.AgregarCuentaBancariaModel
@{
}

<div class="container mt-4 mb-5" style="max-width: 650px;">

    <div class="d-flex align-items-center gap-3 mb-4">
        <a href="/Banco/Bancos" class="btn btn-light border shadow-sm rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
            <i class="bi bi-arrow-left text-secondary"></i>
        </a>
        <div>
            <h1 class="h3 fw-bold mb-0 text-dark">Nueva cuenta bancaria</h1>
            <p class="text-muted small mb-0">Registre los datos de la cuenta para asociarla al sistema.</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form method="post">
                
                <div class="mb-4">
                    <label asp-for="Cuenta.NumeroCuenta" class="form-label small fw-semibold">Número de cuenta <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted"><i class="bi bi-hash"></i></span>
                        <input asp-for="Cuenta.NumeroCuenta" class="form-control border-start-0" placeholder="000-000000-0" required />
                    </div>
                    <span asp-validation-for="Cuenta.NumeroCuenta" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Cuenta.IdTipoCuenta" class="form-label small fw-semibold">Tipo de cuenta <span class="text-danger">*</span></label>
                        <select asp-for="Cuenta.IdTipoCuenta" class="form-select" required>
                            <option value="">Seleccione un tipo</option>
                            @foreach (var tipo in Model.TiposCuenta)
                            {
                                <option value="@tipo.IdTipoCuenta">@tipo.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Cuenta.Moneda" class="form-label small fw-semibold">Moneda <span class="text-danger">*</span></label>
                        <select asp-for="Cuenta.Moneda" class="form-select" required>
                            <option value="CRC">Colones (CRC)</option>
                            <option value="USD">Dólares (USD)</option>
                        </select>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Cuenta.SaldoActual" class="form-label small fw-semibold">Saldo inicial <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted"><i class="bi bi-currency-dollar"></i></span>
                        <input asp-for="Cuenta.SaldoActual" type="number" step="0.01" class="form-control border-start-0" placeholder="0.00" required />
                    </div>
                    <span asp-validation-for="Cuenta.SaldoActual" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-semibold">Cuenta contable asociada <span class="text-danger">*</span></label>
                    <select asp-for="Cuenta.IdCuentaContable" class="form-select">
                        <option value="">Seleccione una cuenta</option>
                        @foreach (var cuenta in Model.CuentasContables)
                        {
                            <option value="@cuenta.IdCuentaContable">@cuenta.NombreCompleto</option>
                        }
                    </select>
                </div>

                <div class="mt-4 pt-4 border-top d-flex justify-content-end gap-2">
                    <a asp-page="/Banco/Bancos" class="btn btn-light border fw-semibold">Cancelar</a>
                    <button type="submit" class="btn text-white fw-semibold" style="background-color: #F2382F;">Guardar Cuenta</button>
                </div>
            </form>
        </div>
    </div>
</div>