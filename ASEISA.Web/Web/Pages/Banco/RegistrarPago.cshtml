@page
@model Web.Pages.Banco.RegistrarPagoModel
@{
    ViewData["Title"] = "Registrar Pago de Factura";
}

<div class="container mt-4 mb-5" style="max-width: 650px;">

    <div class="d-flex align-items-center gap-3 mb-4">
        <a href="/Banco/Bancos" class="btn btn-light border shadow-sm rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
            <i class="bi bi-arrow-left text-secondary"></i>
        </a>
        <div>
            <h1 class="h3 fw-bold mb-0 text-dark">Registrar pago de factura</h1>
            <p class="text-muted small mb-0">Aplique un abono o cancelación de factura hacia una cuenta bancaria.</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.MensajeError))
    {
        <div class="alert alert-danger border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.MensajeError
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form method="post">

                <div class="mb-4">
                    <label asp-for="Pago.IdCuentaCobrar" class="form-label small fw-semibold">Factura de venta pendiente <span class="text-danger">*</span></label>
                    <select asp-for="Pago.IdCuentaCobrar" id="selectFactura" class="form-select" required>
                        <option value="">Seleccione una factura por cobrar</option>
                        @foreach (var cxc in Model.CuentasPorCobrar)
                        {
                            <option value="@cxc.IdCuentaCobrar" data-saldo="@cxc.SaldoPendiente.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                @cxc.NumeroFactura — @cxc.NombreCliente (Saldo: ₡@cxc.SaldoPendiente.ToString("N2"))
                            </option>
                        }
                    </select>
                    <span asp-validation-for="Pago.IdCuentaCobrar" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Pago.IdCuentaBancaria" class="form-label small fw-semibold">Cuenta bancaria destino <span class="text-danger">*</span></label>
                    <select asp-for="Pago.IdCuentaBancaria" class="form-select" required>
                        <option value="">Seleccione una cuenta bancaria</option>
                        @foreach (var cuenta in Model.CuentasBancarias)
                        {
                            <option value="@cuenta.IdCuentaBancaria">
                                @cuenta.NumeroCuenta — @cuenta.TipoCuenta (@cuenta.Moneda)
                            </option>
                        }
                    </select>
                    <span asp-validation-for="Pago.IdCuentaBancaria" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Pago.FechaPago" class="form-label small fw-semibold">Fecha de pago <span class="text-danger">*</span></label>
                        <input asp-for="Pago.FechaPago" type="datetime-local" class="form-control"
                               value="@(Model.Pago.FechaPago?.ToString("yyyy-MM-ddTHH:mm") ?? DateTime.Now.ToString("yyyy-MM-ddTHH:mm"))" required />
                        <span asp-validation-for="Pago.FechaPago" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Pago.Monto" class="form-label small fw-semibold">Monto del pago <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white text-muted"><i class="bi bi-currency-dollar"></i></span>
                            <input asp-for="Pago.Monto" id="inputMonto" type="number" step="0.01" min="0.01" class="form-control border-start-0" placeholder="0.00" required />
                        </div>
                        <span asp-validation-for="Pago.Monto" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Pago.MetodoPago" class="form-label small fw-semibold">Método de pago <span class="text-danger">*</span></label>
                        <select asp-for="Pago.MetodoPago" class="form-select" required>
                            <option value="">Seleccione un método</option>
                            <option value="Transferencia">Transferencia bancaria</option>
                            <option value="SINPE Móvil">SINPE Móvil</option>
                            <option value="Depósito">Depósito bancario</option>
                            <option value="Efectivo">Efectivo</option>
                            <option value="Tarjeta">Tarjeta</option>
                            <option value="Cheque">Cheque</option>
                        </select>
                        <span asp-validation-for="Pago.MetodoPago" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Pago.Referencia" class="form-label small fw-semibold">Referencia / Comprobante</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white text-muted"><i class="bi bi-hash"></i></span>
                            <input asp-for="Pago.Referencia" class="form-control border-start-0" placeholder="Ej. TRF-984512" />
                        </div>
                        <span asp-validation-for="Pago.Referencia" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mt-4 pt-4 border-top d-flex justify-content-end gap-2">
                    <a asp-page="/Banco/Bancos" class="btn btn-light border fw-semibold">Cancelar</a>
                    <button type="submit" class="btn text-white fw-semibold" style="background-color: #F2382F;">Guardar Pago</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Sugiere automáticamente el saldo pendiente al elegir una factura
        document.getElementById('selectFactura')?.addEventListener('change', function () {
            const opcion = this.options[this.selectedIndex];
            const saldo = opcion?.getAttribute('data-saldo');
            const inputMonto = document.getElementById('inputMonto');
            if (saldo && inputMonto) {
                inputMonto.value = parseFloat(saldo).toFixed(2);
            }
        });
    </script>
}
