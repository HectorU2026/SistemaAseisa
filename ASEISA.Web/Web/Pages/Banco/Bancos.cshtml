@page
@model Web.Pages.Banco.BancosModel
@{
    ViewData["Title"] = "Bancos";
}

<link rel="stylesheet" href="~/css/bancos.css" asp-append-version="true" />

<div class="container mt-4 mb-5 bancos-page">

    <!-- ENCABEZADO -->
    <div class="bancos-header">
        <div>
            <div class="bancos-breadcrumb">
                <i class="bi bi-bank"></i>
                <span>Finanzas / Bancos</span>
            </div>
            <h1>Bancos</h1>
            <p>Gestione sus cuentas y movimientos bancarios.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/Banco/AgregarCuentaBancaria" class="btn-banco-primary shadow-sm">
                <i class="bi bi-plus-lg"></i> Nueva cuenta
            </a>
            <a href="/Banco/Movimientos" class="btn-banco-outline">
                <i class="bi bi-arrow-left-right"></i> Movimientos
            </a>
        </div>
    </div>

    <!-- MIS CUENTAS -->
    <p class="banco-section-title">Mis cuentas</p>
    <div class="row g-3 mb-5">
        @if (Model.Cuentas != null && Model.Cuentas.Any())
        {
            foreach (var cuenta in Model.Cuentas)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="banco-card">
                        <div>
                            <div class="banco-card-top">
                                <div class="banco-card-icon"><i class="bi bi-bank"></i></div>
                                <span class="badge-soft is-neutro">@cuenta.TipoCuenta</span>
                            </div>
                            <h5 class="banco-card-numero">@cuenta.NumeroCuenta</h5>
                            <p class="banco-card-nombre">@cuenta.NombreCuentaContable</p>
                        </div>
                        <div class="d-flex justify-content-between align-items-end">
                            <div>
                                <p class="banco-card-saldo-label">Saldo actual</p>
                                <h4 class="banco-card-saldo">
                                    @cuenta.SaldoActual.ToString("N2")
                                    <small>@cuenta.Moneda</small>
                                </h4>
                            </div>
                            <span class="badge-soft @(cuenta.IdEstado == 1 ? "is-activa" : "is-inactiva")">
                                @(cuenta.IdEstado == 1 ? "Activa" : "Inactiva")
                            </span>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="banco-empty">
                    <i class="bi bi-inbox"></i>
                    <strong>No hay cuentas bancarias registradas</strong>
                    <span>Registre su primera cuenta para comenzar.</span>
                    <div class="mt-3">
                        <a href="/Banco/AgregarCuentaBancaria" class="btn-banco-primary">Registrar primera cuenta</a>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- MOVIMIENTOS -->
    <div class="banco-panel">
        <div class="banco-panel-header">
            <div>
                <h6>Últimos movimientos</h6>
                <p>Actividad reciente de sus cuentas</p>
            </div>
            <a href="/Banco/Movimientos" class="btn-banco-outline">Ver todos</a>
        </div>
        <div class="table-responsive">
            <table class="table banco-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Cuenta</th>
                        <th>Tipo</th>
                        <th>Referencia</th>
                        <th class="text-end">Monto</th>
                        <th>Descripción</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Movimientos != null && Model.Movimientos.Any())
                    {
                        foreach (var m in Model.Movimientos)
                        {
                            bool esIngreso = string.Equals(m.TipoMovimiento, "Ingreso", StringComparison.OrdinalIgnoreCase);
                            string montoClase = esIngreso ? "monto-in" : "monto-out";
                            string signo = esIngreso ? "+" : "-";

                            <tr>
                                <td class="text-muted">@m.FechaMovimiento.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="fw-semibold text-dark">@m.NumeroCuenta</td>
                                <td>
                                    <span class="badge-soft @(esIngreso ? "is-activa" : "is-inactiva")">
                                        @m.TipoMovimiento
                                    </span>
                                </td>
                                <td class="text-muted small">@(string.IsNullOrEmpty(m.Referencia) ? "-" : m.Referencia)</td>
                                <td class="text-end @montoClase">@signo ₡@m.Monto.ToString("N2")</td>
                                <td class="text-muted">@m.Descripcion</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-1 d-block mb-3" style="color: #c8ced8;"></i>
                                <strong class="d-block mb-1 text-dark">No hay movimientos registrados</strong>
                                <span class="small">Registre un pago para ver actividad aquí.</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="banco-panel-footer">
            <i class="bi bi-info-circle me-1"></i> Mostrando los últimos @Model.Movimientos.Count movimiento(s) registrado(s).
        </div>
    </div>
</div>