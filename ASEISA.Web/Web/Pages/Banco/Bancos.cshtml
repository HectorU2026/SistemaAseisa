@page
@model Web.Pages.Banco.BancosModel
@{
}

<div class="container mt-4 mb-5">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div class="d-flex align-items-center gap-3">
            <a href="/" class="btn btn-light border shadow-sm rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                <i class="bi bi-arrow-left text-secondary"></i>
            </a>
            <div>
                <h1 class="h3 fw-bold mb-0 text-dark">Bancos</h1>
                <p class="text-muted small mb-0">Gestione sus cuentas y movimientos bancarios.</p>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a href="/Banco/AgregarCuentaBancaria" class="btn text-white fw-semibold" style="background-color: #F2382F;">
                <i class="bi bi-plus-lg me-1"></i> Nueva cuenta
            </a>
            <a href="/Bancos/Movimientos" class="btn btn-outline-secondary fw-semibold">
                <i class="bi bi-arrow-left-right me-1"></i> Movimientos
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        @if (Model.Cuentas != null && Model.Cuentas.Any())
        {
            foreach (var cuenta in Model.Cuentas)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="bg-light rounded-circle d-flex align-items-center justify-content-center text-secondary" style="width: 40px; height: 40px;">
                                    <i class="bi bi-bank"></i>
                                </div>
                                <span class="badge bg-secondary bg-opacity-25 text-dark px-3 py-2 rounded-pill">
                                    @cuenta.TipoCuenta
                                </span>
                            </div>
                            
                            <h5 class="fw-bold mb-1">@cuenta.NumeroCuenta</h5>
                            <p class="text-muted small mb-3">@cuenta.NombreCuentaContable</p>
                            
                            <div class="d-flex justify-content-between align-items-end mt-4">
                                <div>
                                    <p class="text-muted small mb-0">Saldo actual</p>
                                    <h4 class="fw-bold mb-0 text-dark">
                                        @cuenta.SaldoActual.ToString() 
                                        <span class="fs-6 text-muted fw-normal">@cuenta.Moneda</span>
                                    </h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-light border text-center text-muted" role="alert">
                    <i class="bi bi-info-circle me-2"></i> No hay cuentas bancarias registradas.
                </div>
            </div>
        }
    </div>

    <!-- TABLA DE MOVIMIENTOS -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
            <h6 class="fw-bold text-dark mb-0">Últimos movimientos</h6>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-muted small fw-semibold py-3 ps-4">Fecha</th>
                        <th class="text-muted small fw-semibold py-3">Cuenta</th>
                        <th class="text-muted small fw-semibold py-3">Tipo</th>
                        <th class="text-muted small fw-semibold py-3 text-end">Monto</th>
                        <th class="text-muted small fw-semibold py-3">Descripción</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="ps-4 text-muted">12/08/2026</td>
                        <td class="fw-semibold">Banco Nacional</td>
                        <td><span class="badge bg-success bg-opacity-25 text-success px-2 py-1 rounded">Ingreso</span></td>
                        <td class="text-end fw-bold text-success">₡485,000.00</td>
                        <td class="text-muted">Pago factura FAC-002310</td>
                    </tr>
                    <tr>
                        <td class="ps-4 text-muted">10/08/2026</td>
                        <td class="fw-semibold">Banco Nacional</td>
                        <td><span class="badge bg-danger bg-opacity-25 text-danger px-2 py-1 rounded">Egreso</span></td>
                        <td class="text-end fw-bold text-danger">₡395,500.00</td>
                        <td class="text-muted">Pago proveedor PROV-001</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white border-top-0 py-3 px-4 text-muted small">
            Mostrando los últimos movimientos registrados.
        </div>
    </div>
</div>