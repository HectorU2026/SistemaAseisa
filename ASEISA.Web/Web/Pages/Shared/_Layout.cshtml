<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - ASEISA ERP</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/aseisa-erp.css" asp-append-version="true" />
</head>
<body>
    <div class="erp-shell">
        <aside class="erp-sidebar" id="erpSidebar" aria-label="Navegación principal">
            <a asp-page="/Index" class="erp-brand">
                <span class="erp-brand-mark">A</span>
                <span><strong>ASEISA</strong><small>Gestión empresarial</small></span>
            </a>
            <div class="erp-sidebar-caption">GENERAL</div>
            <nav class="erp-nav">
                <a asp-page="/Index"><i class="bi bi-grid-1x2"></i> Panel principal</a>
                <a asp-page="/Seguridad/Login"><i class="bi bi-person-lock"></i> Seguridad</a>
            </nav>
            <div class="erp-sidebar-caption">MÓDULOS</div>
            <nav class="erp-nav">
                <a asp-page="/Index" asp-fragment="comercial"><i class="bi bi-cart3"></i> Comercial</a>
                <a asp-page="/Index" asp-fragment="operaciones"><i class="bi bi-box-seam"></i> Operaciones</a>
                <a asp-page="/Index" asp-fragment="finanzas"><i class="bi bi-bank"></i> Finanzas</a>
                <a asp-page="/Index" asp-fragment="administracion"><i class="bi bi-gear"></i> Administración</a>
            </nav>
            <div class="erp-sidebar-bottom">ASEISA ERP · Versión de desarrollo</div>
        </aside>
        <div class="erp-main">
            <header class="erp-topbar">
                <div class="d-flex align-items-center gap-3">
                    <button type="button" class="erp-menu-toggle" id="erpMenuToggle" aria-label="Abrir o cerrar menú" aria-expanded="false"><i class="bi bi-list"></i></button>
                    <span class="erp-topbar-title">Sistema de gestión empresarial</span>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="erp-user"><i class="bi bi-person-circle"></i> @(User.Identity?.Name ?? "Usuario")</span>
                    <a asp-page="/Seguridad/Logout" class="btn btn-sm btn-outline-secondary" title="Cerrar sesión"><i class="bi bi-box-arrow-right"></i> <span class="d-none d-sm-inline">Salir</span></a>
                </div>
            </header>
            <main class="erp-content" role="main">@RenderBody()</main>
            <footer class="erp-footer">© 2026 ASEISA · Sistema ERP</footer>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        const toggle = document.getElementById('erpMenuToggle');
        toggle?.addEventListener('click', () => {
            const open = document.body.classList.toggle('erp-menu-open');
            toggle.setAttribute('aria-expanded', String(open));
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
