@page
@model Web.Pages.IndexModel

@{
    ViewData["Title"] = "Panel principal";

    // INDICADORES GENERALES
    var indicadores = new[]
    {
        new
        {
            Titulo = "Ventas del mes",
            Icono = "bi-graph-up-arrow",
            Descripcion = "Ingresos comerciales"
        },
        new
        {
            Titulo = "Compras del mes",
            Icono = "bi-cart-check",
            Descripcion = "Operaciones de compra"
        },
        new
        {
            Titulo = "Facturas pendientes",
            Icono = "bi-receipt-cutoff",
            Descripcion = "Documentos pendientes"
        },
        new
        {
            Titulo = "Productos activos",
            Icono = "bi-box-seam",
            Descripcion = "Productos registrados"
        }
    };

    // MÓDULOS DEL SISTEMA
    // Ruta: página Razor a la que dirige la tarjeta.
    // Disponible: indica si el módulo está habilitado.
    var grupos = new (
        string Id,
        string Titulo,
        string Icono,
        (
            string Icono,
            string Nombre,
            string Descripcion,
            string Ruta,
            bool Disponible
        )[] Modulos
    )[]
    {
        (
            "comercial",
            "Gestión comercial",
            "bi-cart3",
            new[]
            {
                (
                    "bi-cart3",
                    "Ventas",
                    "Cotizaciones y ventas",
                    "/Ventas/Listado",
                    false
                ),
                (
                    "bi-receipt",
                    "Facturación",
                    "Comprobantes y notas",
                    "/Facturacion/Listado",
                    false
                ),
                (
                    "bi-people",
                    "Clientes y contactos",
                    "Directorio comercial",
                    "/Contacto/Listado_Contacto",
                    true
                )
            }
        ),
        (
            "operaciones",
            "Operaciones",
            "bi-box-seam",
            new[]
            {
                (
                    "bi-box-seam",
                    "Inventario",
                    "Productos y bodegas",
                    "/Inventario/Listado",
                    false
                ),
                (
                    "bi-truck",
                    "Compras",
                    "Órdenes y proveedores",
                    "/Compras/Listado",
                    false
                ),
                (
                    "bi-building",
                    "Activos fijos",
                    "Registro y depreciación",
                    "/ActivosFijos/Listado",
                    false
                )
            }
        ),
        (
            "finanzas",
            "Finanzas",
            "bi-bank",
            new[]
            {
                (
                    "bi-bank",
                    "Bancos",
                    "Cuentas y movimientos",
                    "/Bancos/Listado",
                    false
                ),
                (
                    "bi-journal-text",
                    "Contabilidad",
                    "Asientos y cuentas",
                    "/Contabilidad/Listado",
                    false
                ),
                (
                    "bi-bar-chart",
                    "Reportes",
                    "Análisis e indicadores",
                    "/Reportes/Listado",
                    false
                )
            }
        ),
        (
            "administracion",
            "Administración",
            "bi-gear",
            new[]
            {
                (
                    "bi-person-gear",
                    "Usuarios",
                    "Accesos y roles",
                    "/Usuarios/Listado",
                    false
                ),
                (
                    "bi-gear",
                    "Configuración",
                    "Parámetros generales",
                    "/Configuracion/Index",
                    false
                )
            }
        )
    };

    int totalModulos = grupos.Sum(g => g.Modulos.Length);
    int modulosDisponibles = grupos.Sum(
        g => g.Modulos.Count(m => m.Disponible));
}

<link rel="stylesheet"
      href="~/css/dashboard-inicio.css"
      asp-append-version="true" />

<div class="dashboard-home">

    <!-- ENCABEZADO PRINCIPAL -->
    <header class="dashboard-header">

        <div>
            <span class="dashboard-eyebrow">
                INICIO / PANEL PRINCIPAL
            </span>

            <h1>Bienvenido a ASEISA</h1>

            <p>
                Consulte el estado general de las operaciones
                y acceda a los módulos de gestión empresarial.
            </p>
        </div>

        <span class="dashboard-environment">
            <i class="bi bi-circle-fill"></i>
            Entorno de desarrollo
        </span>

    </header>

    <!-- INDICADORES GENERALES -->
    <section class="dashboard-kpis"
             aria-label="Indicadores generales">

        @foreach (var indicador in indicadores)
        {
            <article class="dashboard-kpi">

                <div class="kpi-top">
                    <span>@indicador.Titulo</span>

                    <div class="kpi-icon">
                        <i class="bi @indicador.Icono"></i>
                    </div>
                </div>

                <strong class="kpi-value">—</strong>

                <div class="kpi-description">
                    @indicador.Descripcion
                </div>

                <small>
                    <i class="bi bi-clock-history"></i>
                    Pendiente de integración
                </small>

            </article>
        }

    </section>

    <!-- PANELES ANALÍTICOS -->
    <section class="dashboard-analytics"
             aria-label="Resumen de operaciones">

        <!-- RESUMEN DE VENTAS -->
        <article class="dashboard-panel">

            <div class="panel-heading">

                <div>
                    <h2>Resumen de ventas</h2>

                    <p>
                        Comportamiento de las ventas
                        durante los últimos meses.
                    </p>
                </div>

                <span class="panel-tag">
                    Próximamente
                </span>

            </div>

            <div class="panel-empty">

                <div class="empty-icon">
                    <i class="bi bi-graph-up"></i>
                </div>

                <strong>
                    Visualización de ventas
                </strong>

                <p>
                    Aquí se mostrarán los gráficos
                    e indicadores de ventas cuando
                    estén disponibles los datos
                    del módulo comercial.
                </p>

            </div>

        </article>

        <!-- ACTIVIDAD RECIENTE -->
        <article class="dashboard-panel">

            <div class="panel-heading">

                <div>
                    <h2>Actividad reciente</h2>

                    <p>
                        Últimos movimientos registrados
                        en el sistema.
                    </p>
                </div>

            </div>

            <div class="panel-empty">

                <div class="empty-icon">
                    <i class="bi bi-clock-history"></i>
                </div>

                <strong>
                    Sin actividad disponible
                </strong>

                <p>
                    Los movimientos recientes aparecerán
                    aquí cuando se integre la consulta
                    de la bitácora del sistema.
                </p>

            </div>

        </article>

    </section>

    <!-- MÓDULOS DEL SISTEMA -->
    <section class="dashboard-modules"
             aria-labelledby="modulosTitulo">

        <div class="modules-heading">

            <div>
                <h2 id="modulosTitulo">
                    Módulos del sistema
                </h2>

                <p>
                    Explore las herramientas de gestión
                    disponibles en ASEISA.
                </p>
            </div>

            <span class="modules-count">
                @totalModulos módulos
            </span>

        </div>

        <!-- GRUPOS DE MÓDULOS -->
        @foreach (var grupo in grupos)
        {
            <div class="module-group"
                 id="@grupo.Id">

                <h3>
                    <i class="bi @grupo.Icono me-2"></i>
                    @grupo.Titulo
                </h3>

                <div class="module-grid">

                    @foreach (var modulo in grupo.Modulos)
                    {
                        bool disponible = modulo.Disponible;

                        string? ruta = disponible
                            ? Url.Page(modulo.Ruta)
                            : null;

                        <article class="module-card">

                            <div class="module-icon">
                                <i class="bi @modulo.Icono"></i>
                            </div>

                            <div class="module-content">

                                <h4>@modulo.Nombre</h4>

                                <p>
                                    @modulo.Descripcion
                                </p>

                                @if (disponible)
                                {
                                    <span class="module-status module-status-available">
                                        <i class="bi bi-check-circle-fill me-1"></i>
                                        Disponible
                                    </span>
                                }
                                else
                                {
                                    <span class="module-status">
                                        <i class="bi bi-clock me-1"></i>
                                        Próximamente
                                    </span>
                                }

                            </div>

                            @if (disponible && !string.IsNullOrEmpty(ruta))
                            {
                                <a href="@ruta"
                                   class="module-card-link"
                                   aria-label="Acceder a @modulo.Nombre">
                                    <i class="bi bi-arrow-up-right"></i>
                                </a>
                            }
                            else
                            {
                                <i class="bi bi-arrow-up-right module-arrow"></i>
                            }

                        </article>
                    }

                </div>

            </div>
        }

    </section>

    <!-- AVISO DE DESARROLLO -->
    <div class="dashboard-development-note">

        <i class="bi bi-info-circle"></i>

        <div>
            <strong>
                Plataforma en desarrollo
            </strong>

            <p>
                Actualmente hay @modulosDisponibles
                de @totalModulos módulos habilitados.
                Los indicadores, gráficos y módulos
                restantes se integrarán progresivamente
                con los servicios de ASEISA.API.
            </p>
        </div>

    </div>

</div>
