@page
@model Web.Pages.Inventario.ListadoModel

@{
    ViewData["Title"] = "Inventario";
    var columnas = Model.PuedeVerCostos ? 8 : 5;
}

<link rel="stylesheet" href="~/css/contactos.css" asp-append-version="true" />

<div class="contactos-page">
    <div class="contactos-header">
        <div>
            <div class="contactos-breadcrumb">
                <i class="bi bi-box-seam" aria-hidden="true"></i>
                <span>Operaciones / Inventario</span>
            </div>
            <h1>Productos</h1>
            <p>Consulte el catálogo de productos de su empresa.</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.MensajeError))
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>
            @Model.MensajeError
        </div>
    }

    <section class="contactos-panel">
        <div class="contactos-panel-header">
            <div>
                <h2>Listado de productos</h2>
                <p>La búsqueda y la paginación se aplican en el servicio.</p>
            </div>
            @if (string.IsNullOrWhiteSpace(Model.MensajeError))
            {
                <span class="contactos-count">@Model.Total registros</span>
            }
        </div>

        <form method="get" class="contactos-filtros">
            <div class="contactos-search">
                <i class="bi bi-search" aria-hidden="true"></i>
                <input type="text"
                       name="Nombre"
                       value="@Model.Nombre"
                       placeholder="Buscar por nombre..."
                       aria-label="Buscar productos por nombre" />
            </div>

            <select name="TamanoPagina" class="form-select" aria-label="Productos por página">
                <option value="10" selected="@(Model.TamanoPagina == 10)">10 por página</option>
                <option value="25" selected="@(Model.TamanoPagina == 25)">25 por página</option>
                <option value="50" selected="@(Model.TamanoPagina == 50)">50 por página</option>
                <option value="100" selected="@(Model.TamanoPagina == 100)">100 por página</option>
            </select>

            <button type="submit" class="btn btn-contacto-primary">
                <i class="bi bi-funnel" aria-hidden="true"></i>
                Filtrar
            </button>

            <a asp-page="/Inventario/Listado" class="btn btn-contacto-outline">Limpiar</a>
        </form>

        @if (string.IsNullOrWhiteSpace(Model.MensajeError))
        {
            <div class="table-responsive">
                <table class="table contactos-table align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Nombre</th>
                            <th scope="col">Tipo</th>
                            <th scope="col">Política</th>
                            <th scope="col" class="text-end">Precio de venta</th>
                            <th scope="col">Estado</th>
                            @if (Model.PuedeVerCostos)
                            {
                                <th scope="col" class="text-end">Costo promedio</th>
                                <th scope="col">Cuenta de ingreso</th>
                                <th scope="col">Cuenta de gasto</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="@columnas" class="contactos-empty text-center">
                                    <i class="bi bi-inbox" aria-hidden="true"></i>
                                    <strong>No se encontraron productos</strong>
                                    <span>No hay productos que coincidan con la búsqueda.</span>
                                </td>
                            </tr>
                        }
                        @foreach (var producto in Model.Items)
                        {
                            <tr>
                                <td><strong>@producto.Nombre</strong></td>
                                <td>@producto.TipoProducto</td>
                                <td>@producto.PoliticaFacturacion</td>
                                <td class="text-end">@producto.PrecioVenta.ToString("N2")</td>
                                <td>@producto.Estado</td>
                                @if (Model.PuedeVerCostos)
                                {
                                    <td class="text-end">@(producto.CostoPromedio?.ToString("N2") ?? "—")</td>
                                    <td>@producto.CuentaIngreso</td>
                                    <td>@producto.CuentaGasto</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="contactos-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span>Página @Model.Pagina de @Model.TotalPaginas</span>
                <div class="d-flex gap-2">
                    @if (Model.Pagina > 1)
                    {
                        <a class="btn btn-contacto-outline"
                           asp-page="/Inventario/Listado"
                           asp-route-Nombre="@Model.Nombre"
                           asp-route-Pagina="@(Model.Pagina - 1)"
                           asp-route-TamanoPagina="@Model.TamanoPagina">
                            Anterior
                        </a>
                    }
                    @if (Model.Pagina < Model.TotalPaginas)
                    {
                        <a class="btn btn-contacto-outline"
                           asp-page="/Inventario/Listado"
                           asp-route-Nombre="@Model.Nombre"
                           asp-route-Pagina="@(Model.Pagina + 1)"
                           asp-route-TamanoPagina="@Model.TamanoPagina">
                            Siguiente
                        </a>
                    }
                </div>
            </div>
        }
    </section>
</div>
