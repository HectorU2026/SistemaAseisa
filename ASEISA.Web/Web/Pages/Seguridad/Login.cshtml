
@page
@model Web.Pages.Seguridad.LoginModel

@{
    Layout = null;
    ViewData["Title"] = "Iniciar sesión";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>ASEISA · Iniciar sesión</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />

    <link rel="stylesheet"
          href="~/css/aseisa-login.css"
          asp-append-version="true" />
</head>

<body>

    <main class="login-shell">

        <aside class="brand-panel"
               aria-label="Información de ASEISA">

            <div class="brand-top">

                <div class="brand-logo-container">
                    <img src="~/img/logo-aseisa.png"
                         asp-append-version="true"
                         alt="ASEISA - Asesoría y Servicios Integrados S.A."
                         class="brand-logo" />
                </div>

                <div class="brand-identity">
                    <strong>Sistema ERP</strong>
                    <span>Gestión empresarial ASEISA</span>
                </div>

            </div>

            <div class="brand-content">

                <span class="brand-kicker">
                    <i class="bi bi-stars"></i>
                    Una plataforma, todos sus procesos
                </span>

                <h1>
                    Su empresa,
                    <em>mejor conectada.</em>
                </h1>

                <p>
                    Organice ventas, compras, inventario y finanzas
                    desde un espacio de trabajo unificado.
                </p>

                <div class="brand-features">

                    <span>
                        <i class="bi bi-check2-circle"></i>
                        Procesos centralizados
                    </span>

                    <span>
                        <i class="bi bi-check2-circle"></i>
                        Información organizada
                    </span>

                    <span>
                        <i class="bi bi-check2-circle"></i>
                        Gestión más eficiente
                    </span>

                </div>

            </div>

            <div class="brand-bottom">
                ASEISA · Sistema de gestión empresarial
            </div>

        </aside>

        <section class="form-panel">

            <div class="login-card">

                <div class="mobile-brand">

                    <img src="~/img/logo-aseisa.png"
                         asp-append-version="true"
                         alt="Logotipo de ASEISA"
                         class="mobile-brand-logo" />

                    <strong>ASEISA</strong>

                </div>

                <div class="welcome-label">
                    BIENVENIDO DE NUEVO
                </div>

                <h2>Iniciar sesión</h2>

                <p class="intro">
                    Ingrese sus credenciales para acceder
                    a su espacio de trabajo.
                </p>

                @if (!string.IsNullOrWhiteSpace(Model.MensajeError))
                {
                    <div class="alert login-alert
                                d-flex align-items-start gap-2"
                         role="alert">

                        <i class="bi bi-exclamation-circle-fill"></i>

                        <span>@Model.MensajeError</span>

                    </div>
                }

                <form method="post" novalidate>

                    @Html.AntiForgeryToken()

                    <div class="field-group">

                        <label asp-for="loginInfo.Correo">
                            Correo electrónico
                        </label>

                        <div class="field-input @(ViewData.ModelState.ContainsKey("loginInfo.Correo") && ViewData.ModelState["loginInfo.Correo"]!.Errors.Count > 0 ? "invalid" : "")">

                            <i class="bi bi-envelope"></i>

                            <input asp-for="loginInfo.Correo"
                                   type="email"
                                   autocomplete="username"
                                   placeholder="nombre@aseisa.com" />

                        </div>

                        <span asp-validation-for="loginInfo.Correo"
                              class="field-error"></span>

                    </div>

                    <div class="field-group">

                        <div class="field-label-row">

                            <label asp-for="loginInfo.ContrasenaHash">
                                Contraseña
                            </label>

                            <a asp-page="/Seguridad/Restablecer_Contrasena">
                                ¿Olvidó su contraseña?
                            </a>

                        </div>

                        <div class="field-input @(ViewData.ModelState.ContainsKey("loginInfo.ContrasenaHash") && ViewData.ModelState["loginInfo.ContrasenaHash"]!.Errors.Count > 0 ? "invalid" : "")">

                            <i class="bi bi-lock"></i>

                            <input asp-for="loginInfo.ContrasenaHash"
                                   type="password"
                                   autocomplete="current-password"
                                   placeholder="Ingrese su contraseña" />

                            <button type="button"
                                    class="toggle-password"
                                    aria-label="Mostrar contraseña"
                                    aria-pressed="false"
                                    id="togglePassword">

                                <i class="bi bi-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="loginInfo.ContrasenaHash"
                              class="field-error"></span>

                    </div>

                    <button class="submit-button"
                            type="submit">

                        Ingresar al sistema

                        <i class="bi bi-arrow-right"></i>

                    </button>

                </form>

                <p class="register-line">

                    ¿No tiene una cuenta?

                    <a asp-page="/Seguridad/Registro_Aseisa">
                        Regístrese aquí
                    </a>

                </p>

                <p class="login-footer">
                    <i class="bi bi-shield-lock"></i>
                    Acceso exclusivo para usuarios autorizados
                </p>

            </div>

        </section>

    </main>

    <script>
        (() => {

            const button =
                document.getElementById('togglePassword');

            const input =
                document.getElementById(
                    'loginInfo_ContrasenaHash'
                );

            if (!button || !input) return;

            button.addEventListener('click', () => {

                const visible =
                    input.type === 'password';

                input.type =
                    visible ? 'text' : 'password';

                button.setAttribute(
                    'aria-pressed',
                    String(visible)
                );

                button.setAttribute(
                    'aria-label',
                    visible
                        ? 'Ocultar contraseña'
                        : 'Mostrar contraseña'
                );

                button.querySelector('i').className =
                    visible
                        ? 'bi bi-eye-slash'
                        : 'bi bi-eye';

            });

        })();
    </script>

</body>
</html>
