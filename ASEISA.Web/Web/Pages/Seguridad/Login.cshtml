@page
@model Web.Pages.Seguridad.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ASEISA · Iniciar sesión</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/estilos.css">
<style>
  body{ font-family:'Inter',system-ui,sans-serif; background:#F5F7FA; }
  .btn-aseisa{ background:#F2382F; border-color:#F2382F; color:#fff; }
  .btn-aseisa:hover{ background:#C92C24; border-color:#C92C24; color:#fff; }
  a{ color:#F2382F; }
</style>
</head>
<body class="d-flex align-items-center justify-content-center min-vh-100 p-3">

  <div class="card shadow-sm border-0" style="max-width:380px; width:100%;">
    <div class="card-body p-4">

      <div class="bg-danger bg-opacity-10 rounded d-inline-flex align-items-center justify-content-center mb-3"
           style="width:40px;height:40px;background-color:#F2382F !important;">
        <span class="text-white fw-bold">A</span>
      </div>

      <h1 class="h5 fw-bold mb-1">Iniciar sesión</h1>
      <p class="text-secondary small mb-3">Ingrese sus credenciales para acceder al sistema.</p>

      <form method="post">
        <div class="mb-3">
          <label asp-for="loginInfo.Correo" class="form-label small fw-semibold">Correo electrónico</label>
          <div class="input-group">
            <span class="input-group-text bg-white"><i class="bi bi-envelope"></i></span>
            <input asp-for="loginInfo.Correo" type="email" class="form-control" placeholder="nombre@aseisa.com">
          </div>
        </div>

        <div class="mb-2">
          <label asp-for="loginInfo.contrasena" class="form-label small fw-semibold">Contraseña</label>
          <div class="input-group">
            <span class="input-group-text bg-white"><i class="bi bi-lock"></i></span>
            <input asp-for="loginInfo.contrasena" type="password" class="form-control" placeholder="••••••••">
          </div>
        </div>
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div class="alert alert-danger small" role="alert">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }
        <div class="text-end mb-3">
          <a class="small fw-semibold text-decoration-none" asp-page="/Seguridad/Restablecer_Contrasena">¿Olvidó su contraseña?</a>
        </div>

        <button type="submit" class="btn btn-aseisa w-100 fw-semibold">Iniciar sesión</button>
      </form>

      <p class="text-center text-secondary small mt-3 mb-0">
        ¿No tiene una cuenta?
        <a class="fw-semibold text-decoration-none" asp-page="/Seguridad/Registro_Aseisa">Regístrese aquí</a>
      </p>

    </div>
  </div>

</body>
</html>