@page
@model Web.Pages.Seguridad.RegistroModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>ASEISA | Crear cuenta</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/css/registro.css"
          asp-append-version="true" />
</head>

<body class="min-vh-100 d-flex align-items-center justify-content-center p-3 py-5">

    <div class="card register-card">
        <div class="card-body p-4 p-md-5">

            <!-- Encabezado -->
            <div class="d-flex align-items-center gap-3 mb-4">
                <img src="~/img/logo-aseisa.png"
                 alt="Logo de ASEISA"
                 class="register-logo"
                 asp-append-version="true" />
                <div>
                    <h1 class="h4 fw-bold mb-1">Crear cuenta</h1>
                    <p class="text-secondary small mb-0">
                        Complete sus datos para registrarse en ASEISA.
                    </p>
                </div>
            </div>

            <!-- Indicador de pasos -->
            <div class="row g-2 mb-3">

                <div class="col-4 step-item active" data-indicator="0">
                    <div class="step-circle mb-2">1</div>
                    Identificación
                </div>

                <div class="col-4 step-item" data-indicator="1">
                    <div class="step-circle mb-2">2</div>
                    Datos personales
                </div>

                <div class="col-4 step-item" data-indicator="2">
                    <div class="step-circle mb-2">3</div>
                    Acceso
                </div>

            </div>

            <!-- Barra de progreso -->
            <div class="progress rounded-pill mb-4">
                <div id="stepProgress"
                     class="progress-bar"
                     style="width: 33.33%">
                </div>
            </div>

            <form method="post" id="registroForm" novalidate>

                <!-- Errores generales del servidor -->
                <div asp-validation-summary="ModelOnly"
                     class="text-danger small mb-3">
                </div>

                <!-- PASO 1: IDENTIFICACIÓN -->
                <section class="registration-step active" data-step="0">

                    <h2 class="form-section-title">
                        <i class="bi bi-person-vcard me-2 text-aseisa"></i>
                        Identificación del cliente
                    </h2>

                    <p class="form-section-description">
                        Indique el tipo de cliente y su identificación.
                    </p>

                    <!-- Tipo de cliente -->
                    <div class="mb-4">
                        <label class="form-label">
                            Tipo de cliente
                            <span class="text-danger">*</span>
                        </label>

                        <div class="row g-2">

                            <div class="col-sm-6">
                                <label class="client-type-option d-flex gap-2 align-items-center">
                                    <input type="radio"
                                           name="Formulario.TipoCliente"
                                           value="Persona física"
                                           class="form-check-input mt-0"
                                           checked="@(Model.Formulario.TipoCliente == "Persona física")" />

                                    <span>
                                        <i class="bi bi-person me-1"></i>
                                        Persona física
                                    </span>
                                </label>
                            </div>

                            <div class="col-sm-6">
                                <label class="client-type-option d-flex gap-2 align-items-center">
                                    <input type="radio"
                                           name="Formulario.TipoCliente"
                                           value="Persona jurídica"
                                           class="form-check-input mt-0"
                                           checked="@(Model.Formulario.TipoCliente == "Persona jurídica")" />

                                    <span>
                                        <i class="bi bi-building me-1"></i>
                                        Persona jurídica
                                    </span>
                                </label>
                            </div>

                        </div>

                        <span asp-validation-for="Formulario.TipoCliente"
                              class="text-danger small"></span>

                        <div id="tipoFeedback" class="feedback-text"></div>
                    </div>

                    <!-- Identificación -->
                    <div class="mb-3">
                        <label for="Formulario_Identificacion"
                               id="identificacionLabel"
                               class="form-label">
                            Identificación
                            <span class="text-danger">*</span>
                        </label>

                        <input asp-for="Formulario.Identificacion"
                               class="form-control"
                               inputmode="numeric"
                               autocomplete="off"
                               placeholder="1-1234-5678" />

                        <div id="identificacionFeedback"
                             class="feedback-text"></div>

                        <span asp-validation-for="Formulario.Identificacion"
                              class="text-danger small"></span>
                    </div>

                    <!-- Razón social -->
                    <div class="mb-3"
                         id="razonSocialContainer"
                         hidden>

                        <label asp-for="Formulario.RazonSocial"
                               class="form-label">
                            Razón social
                            <span class="text-danger">*</span>
                        </label>

                        <input asp-for="Formulario.RazonSocial"
                               class="form-control"
                               maxlength="200"
                               placeholder="Ej. Comercial ABC S.A." />

                        <div id="razonSocialFeedback"
                             class="feedback-text"></div>

                        <span asp-validation-for="Formulario.RazonSocial"
                              class="text-danger small"></span>
                    </div>

                    <!-- Empresa -->
                    <div class="mb-3">
                        <label asp-for="Formulario.IdEmpresa"
                               class="form-label">
                            Empresa
                            <span class="text-danger">*</span>
                        </label>

                        <select asp-for="Formulario.IdEmpresa"
                                class="form-select">

                            <option value="">Seleccione una empresa</option>

                            @foreach (var empresa in Model.Empresas)
                            {
                                <option value="@empresa.IdEmpresa">
                                    @empresa.NombreComercial
                                </option>
                            }
                        </select>

                        <div id="empresaFeedback"
                             class="feedback-text"></div>

                        <span asp-validation-for="Formulario.IdEmpresa"
                              class="text-danger small"></span>
                    </div>

                </section>

                <!-- PASO 2: DATOS PERSONALES -->
                <section class="registration-step" data-step="1">

                    <h2 class="form-section-title">
                        <i class="bi bi-person-lines-fill me-2 text-aseisa"></i>
                        <span id="personalTitle">Datos personales</span>
                    </h2>

                    <p id="personalDescription"
                       class="form-section-description">
                        Ingrese sus datos personales y de contacto.
                    </p>

                    <div class="row g-3">

                        <!-- Nombre -->
                        <div class="col-md-6">
                            <label asp-for="Formulario.Nombre"
                                   class="form-label">
                                Nombre
                                <span class="text-danger">*</span>
                            </label>

                            <input asp-for="Formulario.Nombre"
                                   class="form-control"
                                   maxlength="80"
                                   autocomplete="given-name"
                                   placeholder="Ej. María" />

                            <div id="nombreFeedback"
                                 class="feedback-text"></div>

                            <span asp-validation-for="Formulario.Nombre"
                                  class="text-danger small"></span>
                        </div>

                        <!-- Primer apellido -->
                        <div class="col-md-6">
                            <label asp-for="Formulario.PrimerApellido"
                                   class="form-label">
                                Primer apellido
                                <span class="text-danger">*</span>
                            </label>

                            <input asp-for="Formulario.PrimerApellido"
                                   class="form-control"
                                   maxlength="80"
                                   autocomplete="family-name"
                                   placeholder="Ej. Fernández" />

                            <div id="apellidoFeedback"
                                 class="feedback-text"></div>

                            <span asp-validation-for="Formulario.PrimerApellido"
                                  class="text-danger small"></span>
                        </div>

                        <!-- Segundo apellido -->
                        <div class="col-md-6">
                            <label asp-for="Formulario.SegundoApellido"
                                   class="form-label">
                                Segundo apellido
                            </label>

                            <input asp-for="Formulario.SegundoApellido"
                                   class="form-control"
                                   maxlength="80"
                                   placeholder="Ej. Mora" />
                        </div>

                        <!-- Teléfono -->
                        <div class="col-md-6">
                            <label asp-for="Formulario.Telefono"
                                   class="form-label">
                                Teléfono (opcional)
                            </label>

                            <input asp-for="Formulario.Telefono"
                                   class="form-control"
                                   inputmode="tel"
                                   maxlength="9"
                                   placeholder="8888-8888" />

                            <div id="telefonoFeedback"
                                 class="feedback-text"></div>

                            <span asp-validation-for="Formulario.Telefono"
                                  class="text-danger small"></span>
                        </div>

                        <!-- Dirección -->
                        <div class="col-12">
                            <label asp-for="Formulario.Direccion"
                                   class="form-label">
                                Dirección (opcional)
                            </label>

                            <input asp-for="Formulario.Direccion"
                                   class="form-control"
                                   maxlength="250"
                                   placeholder="Provincia, cantón, distrito..." />
                        </div>

                    </div>

                </section>

                <!-- PASO 3: DATOS DE ACCESO -->
                <section class="registration-step" data-step="2">

                    <h2 class="form-section-title">
                        <i class="bi bi-shield-lock me-2 text-aseisa"></i>
                        Datos de acceso
                    </h2>

                    <p class="form-section-description">
                        Configure las credenciales para iniciar sesión.
                    </p>

                    <!-- Nombre de usuario -->
                    <div class="mb-3">
                        <label asp-for="Formulario.NombreUsuario"
                               class="form-label">
                            Nombre de usuario
                        </label>

                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-person-check"></i>
                            </span>

                            <input asp-for="Formulario.NombreUsuario"
                                   class="form-control readonly-field"
                                   readonly
                                   placeholder="Se generará automáticamente" />
                        </div>

                        <div class="form-text">
                            Se genera automáticamente con la inicial del nombre,
                            el primer apellido y los últimos cuatro dígitos
                            de la identificación.
                        </div>
                    </div>

                    <!-- Correo -->
                    <div class="mb-3">
                        <label asp-for="Formulario.Correo"
                               class="form-label">
                            Correo electrónico
                            <span class="text-danger">*</span>
                        </label>

                        <input asp-for="Formulario.Correo"
                               type="email"
                               class="form-control"
                               maxlength="254"
                               autocomplete="email"
                               placeholder="nombre@correo.com" />

                        <div id="correoFeedback"
                             class="feedback-text"></div>

                        <span asp-validation-for="Formulario.Correo"
                              class="text-danger small"></span>
                    </div>

                    <!-- Contraseña -->
                    <div class="mb-3">
                        <label asp-for="Formulario.Contrasena"
                               class="form-label">
                            Contraseña
                            <span class="text-danger">*</span>
                        </label>

                        <div class="input-group">
                            <input asp-for="Formulario.Contrasena"
                                   type="password"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="Ingrese una contraseña segura" />

                            <button type="button"
                                    class="btn btn-outline-secondary password-toggle"
                                    data-toggle-password="Formulario_Contrasena"
                                    aria-label="Mostrar u ocultar contraseña">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>

                        <div id="passwordFeedback"
                             class="feedback-text"></div>

                        <span asp-validation-for="Formulario.Contrasena"
                              class="text-danger small"></span>
                    </div>

                    <!-- Confirmación -->
                    <div class="mb-3">
                        <label asp-for="Formulario.ConfirmarContrasena"
                               class="form-label">
                            Confirmar contraseña
                            <span class="text-danger">*</span>
                        </label>

                        <div class="input-group">
                            <input asp-for="Formulario.ConfirmarContrasena"
                                   type="password"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="Repita su contraseña" />

                            <button type="button"
                                    class="btn btn-outline-secondary password-toggle"
                                    data-toggle-password="Formulario_ConfirmarContrasena"
                                    aria-label="Mostrar u ocultar confirmación">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>

                        <div id="confirmarFeedback"
                             class="feedback-text"></div>

                        <span asp-validation-for="Formulario.ConfirmarContrasena"
                              class="text-danger small"></span>
                    </div>

                </section>

                <!-- Navegación -->
                <div class="d-flex justify-content-between gap-3 mt-4">

                    <button type="button"
                            id="btnAnterior"
                            class="btn btn-outline-secondary"
                            hidden>
                        <i class="bi bi-arrow-left me-1"></i>
                        Anterior
                    </button>

                    <button type="button"
                            id="btnSiguiente"
                            class="btn btn-aseisa ms-auto">
                        Siguiente
                        <i class="bi bi-arrow-right ms-1"></i>
                    </button>

                    <button type="submit"
                            id="btnRegistrar"
                            class="btn btn-aseisa ms-auto"
                            hidden>
                        <i class="bi bi-check-circle me-1"></i>
                        Crear cuenta
                    </button>

                </div>

            </form>

            <!-- Inicio de sesión -->
            <p class="text-center text-secondary small mt-4 mb-0">
                ¿Ya tiene una cuenta?

                <a asp-page="/Seguridad/Login"
                   class="text-aseisa fw-semibold text-decoration-none">
                    Inicie sesión aquí
                </a>
            </p>

        </div>
    </div>

    <script src="~/js/registro.js"
            asp-append-version="true"></script>

</body>
</html>
