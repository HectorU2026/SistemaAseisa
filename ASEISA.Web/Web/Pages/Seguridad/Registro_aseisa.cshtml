@page
@model Web.Pages.Seguridad.RegistroModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ASEISA · Crear cuenta</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/estilos.css">
<style>
  body{ font-family:'Inter',system-ui,sans-serif; background:#F5F7FA; }
  .btn-aseisa{ background:#F2382F; border-color:#F2382F; color:#fff; }
  .btn-aseisa:hover{ background:#C92C24; border-color:#C92C24; color:#fff; }
  a{ color:#F2382F; }
</style>
</head>
<body class="d-flex align-items-center justify-content-center min-vh-100 p-3">

<div class="card shadow-sm border-0" style="max-width:420px; width:100%;">
  <div class="card-body p-4">

    <div class="rounded d-inline-flex align-items-center justify-content-center mb-3"
         style="width:40px;height:40px;background-color:#F2382F;">
      <span class="text-white fw-bold">A</span>
    </div>

    <h1 class="h5 fw-bold mb-1">Crear cuenta</h1>
    <p class="text-secondary small mb-3">Regístrese como cliente final para acceder al sistema.</p>

    <form method="post">
      <div class="mb-4">
        <label asp-for="Cliente.Identificacion" class="form-label small fw-semibold">Identificacion <span class="text-secondary fw-normal"></span></label>
        <input asp-for="Cliente.Identificacion" class="form-control" placeholder="0-0000-0000" />
      </div>
      <div class="mb-3">
        <label asp-for="Usuario.Nombre" class="form-label small fw-semibold">Nombre <span class="text-danger">*</span></label>
        <input asp-for="Usuario.Nombre" class="form-control" placeholder="Ej. María" />
      </div>

      <div class="mb-3">
        <label asp-for="Usuario.PrimerApellido" class="form-label small fw-semibold">Primer apellido <span class="text-danger">*</span></label>
        <input asp-for="Usuario.PrimerApellido" class="form-control" placeholder="Fernández" />
      </div>

      <div class="mb-3">
        <label asp-for="Usuario.SegundoApellido" class="form-label small fw-semibold">Segundo apellido</label>
        <input asp-for="Usuario.SegundoApellido" class="form-control" placeholder="Mora" />
      </div>

      <div class="mb-3">
        <label asp-for="Usuario.NombreUsuario" class="form-label small fw-semibold">Nombre de usuario</label>
        <input asp-for="Usuario.NombreUsuario" class="form-control" placeholder="nombre_usuario" />
      </div>

      <div class="mb-3">
        <label asp-for="Usuario.Correo" class="form-label small fw-semibold">Correo electrónico <span class="text-danger">*</span></label>
        <input asp-for="Usuario.Correo" type="email" class="form-control" placeholder="nombre@correo.com" />
      </div>

      <div class="mb-3">
        <label asp-for="Usuario.ContrasenaHash" class="form-label small fw-semibold">Contraseña <span class="text-danger">*</span></label>
        <input asp-for="Usuario.ContrasenaHash" type="password" class="form-control" placeholder="••••••••" />
        <div class="form-text small">Mínimo 8 caracteres, una mayúscula y un número.</div>
      </div>

      <div class="mb-3">
        <label asp-for="Cliente.Telefono" class="form-label small fw-semibold">Teléfono <span class="text-secondary fw-normal">(opcional)</span></label>
        <input asp-for="Cliente.Telefono" class="form-control" placeholder="8888-8888" />
      </div>

      <div class="mb-4">
        <label asp-for="Cliente.Direccion" class="form-label small fw-semibold">Dirección <span class="text-secondary fw-normal">(opcional)</span></label>
        <input asp-for="Cliente.Direccion" class="form-control" placeholder="Provincia, cantón, distrito" />
      </div>
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@error.ErrorMessage</div>
        }
      <button type="submit" class="btn btn-aseisa w-100 fw-semibold">Guardar</button>
    </form>

    <p class="text-center text-secondary small mt-3 mb-0">
      ¿Ya tiene una cuenta?
      <a asp-page="/Seguridad/Login" class="fw-semibold text-decoration-none">Inicie sesión aquí</a>
    </p>

  </div>
</div>

</body>
</html>