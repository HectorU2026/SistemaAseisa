
@page
@model Web.Views.Home.Inicio_Sesion.Cambiar_ContrasenaModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>ASEISA | Nueva contraseña</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">

    <link rel="stylesheet"
          href="~/css/cambiar-contrasena.css"
          asp-append-version="true">
</head>

<body>

    <main class="auth-container">

        <div class="auth-card">

            <div class="auth-header">

                <div class="brand-logo">
                    <img src="~/img/logo-aseisa.png"
                         alt="ASEISA">
                </div>

                <span class="brand-name">ASEISA</span>

                <div class="security-icon">
                    <i class="bi bi-shield-lock"></i>
                </div>

                <h1>Nueva contraseña</h1>

                <p>
                    Establezca una nueva contraseña para
                    recuperar el acceso a su cuenta.
                </p>

            </div>

            <form method="post" id="passwordForm">

                <input type="hidden"
                       asp-for="Cambio.Token"
                       value="@Model.Token" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger small mb-3"></div>

                <div class="form-group">

                    <label asp-for="Cambio.NuevaContrasena"
                           class="form-label">
                        Nueva contraseña
                    </label>

                    <div class="input-wrapper">

                        <i class="bi bi-lock input-icon"></i>

                        <input asp-for="Cambio.NuevaContrasena"
                               type="password"
                               id="newPassword"
                               class="form-control custom-input"
                               placeholder="Ingresá tu nueva contraseña"
                               autocomplete="new-password"
                               required />

                        <button type="button"
                                class="toggle-password"
                                data-target="newPassword"
                                aria-label="Mostrar contraseña">
                            <i class="bi bi-eye"></i>
                        </button>

                    </div>

                    <span asp-validation-for="Cambio.NuevaContrasena"
                          class="text-danger small"></span>

                    <div class="strength-container">

                        <div class="strength-bars">
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>

                        <small id="strengthText">
                            Seguridad de la contraseña
                        </small>

                    </div>

                </div>

                <div class="form-group">

                    <label asp-for="Cambio.ConfirmarContrasena"
                           class="form-label">
                        Confirmar contraseña
                    </label>

                    <div class="input-wrapper">

                        <i class="bi bi-shield-check input-icon"></i>

                        <input asp-for="Cambio.ConfirmarContrasena"
                               type="password"
                               id="confirmPassword"
                               class="form-control custom-input"
                               placeholder="Repetí tu nueva contraseña"
                               autocomplete="new-password"
                               required />

                        <button type="button"
                                class="toggle-password"
                                data-target="confirmPassword"
                                aria-label="Mostrar contraseña">
                            <i class="bi bi-eye"></i>
                        </button>

                    </div>

                    <span asp-validation-for="Cambio.ConfirmarContrasena"
                          class="text-danger small"></span>

                    <small id="matchMessage"
                           class="password-match"></small>

                </div>

                <div class="security-tips">

                    <div class="tips-title">
                        <i class="bi bi-info-circle"></i>
                        Recomendaciones de seguridad
                    </div>

                    <ul>
                        <li>Utilice al menos 8 caracteres.</li>
                        <li>Combine letras, números y símbolos.</li>
                        <li>Evite reutilizar contraseñas anteriores.</li>
                    </ul>

                </div>

                <button type="submit"
                        class="btn btn-aseisa w-100"
                        id="submitButton">

                    <i class="bi bi-check-circle me-2"></i>
                    Guardar nueva contraseña

                </button>

            </form>

            <div class="auth-footer">

                <a asp-page="/Seguridad/Login">
                    <i class="bi bi-arrow-left me-1"></i>
                    Volver a iniciar sesión
                </a>

            </div>

        </div>

        <div class="page-footer">
            <i class="bi bi-lock-fill me-1"></i>
            Recuperación segura de cuenta · ASEISA
        </div>

    </main>

    <script src="~/js/cambiar-contrasena.js"
            asp-append-version="true"></script>

</body>
</html>
