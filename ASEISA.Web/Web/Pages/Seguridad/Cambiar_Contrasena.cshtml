@page
@model Web.Views.Home.Inicio_Sesion.Cambiar_ContrasenaModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ASEISA · Cambiar contraseña</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="../css/estilos.css">
    <style>
            body{ font-family:'Inter',system-ui,sans-serif; background:#F5F7FA; }
            .btn-aseisa{ background:#F2382F; border-color:#F2382F; color:#fff; }
            .btn-aseisa:hover{ background:#C92C24; border-color:#C92C24; color:#fff; }
            a{ color:#F2382F; }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center min-vh-100 p-3">

    <div class="card shadow-sm border-0" style="max-width:380px; width:100%;">
        <div class="card-body p-4">

            <div class="bg-danger bg-opacity-10 rounded d-inline-flex align-items-center justify-content-center mb-3"
                 style="width:40px;height:40px;background-color:#F2382F !important;">
                <span class="text-white fw-bold">A</span>
            </div>

            <h1 class="h5 fw-bold mb-1">Cambiar contraseña</h1>
            <p class="text-secondary small mb-3">Ingrese su nueva contraseña.</p>

            <form method="post">
                <input type="hidden" asp-for="Cambio.Token" value="@Model.Token" />

                <div class="mb-3">
                    <label asp-for="Cambio.NuevaContrasena" class="form-label small fw-semibold">Nueva contraseña</label>
                    <input asp-for="Cambio.NuevaContrasena" type="password" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Cambio.ConfirmarContrasena" class="form-label small fw-semibold">Confirmar contraseña</label>
                    <input asp-for="Cambio.ConfirmarContrasena" type="password" class="form-control" />
                </div>
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                {
                    <div class="alert alert-danger small" role="alert">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    </div>
                }
                <button type="submit" class="btn btn-aseisa w-100 fw-semibold">Cambiar contraseña</button>
            </form>

            <p class="text-center text-secondary small mt-3 mb-0">
                <a asp-page="/Seguridad/Login" class="fw-semibold text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i>Volver a iniciar sesión
                </a>
            </p>

        </div>
    </div>

</body>
</html>