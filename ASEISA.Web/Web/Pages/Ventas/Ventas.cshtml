@page
@model Web.Pages.Ventas.VentasModel
@{
    ViewData["Title"] = "Ventas";
}

<link rel="stylesheet" href="~/css/ventas.css" asp-append-version="true" />

<div class="container mt-4 mb-5 ventas-page">

    <!-- ENCABEZADO -->
    <div class="ventas-header">
        <div>
            <div class="ventas-breadcrumb">
                <i class="bi bi-cart3"></i>
                <span>Gestión comercial / Ventas</span>
            </div>
            <h1>Ventas</h1>
            <p>Administre sus cotizaciones y órdenes de venta activas.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/Ventas/Crear" class="btn-venta-primary shadow-sm">
                <i class="bi bi-plus-lg"></i> Nueva Cotización
            </a>
        </div>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- FILTROS -->
    <form method="get" class="ventas-filtros">
        <div class="ventas-search">
            <i class="bi bi-search"></i>
            <input type="text" name="busqueda" value="@Request.Query["busqueda"]" placeholder="Buscar por número o cliente..." />
        </div>

        <select name="idEstado" class="form-select">
            <option value="">Todos los estados activos</option>
            <option value="1" selected="@(Request.Query["idEstado"] == "1")">Cotización</option>
            <option value="2" selected="@(Request.Query["idEstado"] == "2")">Cotización Enviada</option>
            <option value="3" selected="@(Request.Query["idEstado"] == "3")">Orden de Venta</option>
        </select>

        <button type="submit" class="btn-venta-primary">
            <i class="bi bi-funnel"></i> Filtrar
        </button>

        <a href="/Ventas/Ventas" class="btn-venta-outline">Limpiar</a>

        <a href="/Ventas/ventas_canceladas" class="btn-venta-outline ms-auto text-danger" style="border-color: #dc3545;">
            <i class="bi bi-x-circle"></i> Canceladas
        </a>
    </form>

    <!-- TABLA -->
    <div class="ventas-panel">
        <div class="table-responsive">
            <table class="table ventas-table align-middle">
                <thead>
                    <tr>
                        <th>Cotización</th>
                        <th>Cliente</th>
                        <th>Vencimiento</th>
                        <th class="text-end">Total</th>
                        <th class="text-center">Estado</th>
                        <th style="width: 40px;"></th>
                    </tr>
                </thead>
                <tbody id="tbodyVentas">
                    @if (Model.Cotizaciones != null && Model.Cotizaciones.Any())
                    {
                        foreach (var item in Model.Cotizaciones)
                        {
                            string badgeClass = "bg-cotizacion";
                            if (item.Estado == "Cotización Enviada") badgeClass = "bg-enviada";
                            else if (item.Estado == "Orden de Venta") badgeClass = "bg-orden";

                            <!-- QUITAMOS data-bs-toggle="collapse" PARA CONTROLARLO CON JS -->
                            <tr class="fila-principal"
                                data-numero="@item.NumeroCotizacion.ToLower()"
                                data-cliente="@item.NombreCliente.ToLower()"
                                data-estado="@item.Estado"
                                data-bs-target="#panel-@item.IdCotizacion"
                                aria-expanded="false">
                                <td class="fw-bold text-dark">@item.NumeroCotizacion</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background: #fff0ef; color: #F2382F; font-weight: bold;">
                                            @item.NombreCliente.Substring(0, 1).ToUpper()
                                        </div>
                                        <span class="fw-semibold text-secondary">@item.NombreCliente</span>
                                    </div>
                                </td>
                                <td class="text-muted small">@(item.FechaVencimiento?.ToString("dd MMM, yyyy") ?? "-")</td>
                                <td class="text-end fw-bold text-dark">@item.Total.ToString("C")</td>
                                <td class="text-center">
                                    <span class="badge-venta @badgeClass">@item.Estado</span>
                                </td>
                                <td class="text-center text-muted">
                                    <i class="bi bi-chevron-down chevron-icon"></i>
                                </td>
                            </tr>

                            <tr class="collapse fila-panel" id="panel-@item.IdCotizacion">
                                <td colspan="6">
                                    <div class="panel-contenido">

                                        <!-- OPCIONES: COTIZACIÓN -->
                                        @if (item.Estado == "Cotización")
                                        {
                                            <div class="panel-titulo"><i class="bi bi-pencil-square"></i> Acciones de la Cotización</div>
                                            <div class="row g-3 align-items-end">
                                                <div class="col-md-auto">
                                                    <a href="/Ventas/Editar/@item.IdCotizacion" class="btn-venta-outline w-100">
                                                        <i class="bi bi-pencil"></i> Editar
                                                    </a>
                                                </div>
                                                <div class="col-md-auto">
                                                    <form method="post" asp-page-handler="Avanzar">
                                                        <input type="hidden" name="idCotizacion" value="@item.IdCotizacion" />
                                                        <button type="submit" class="btn-venta-primary" onclick="event.stopPropagation();">
                                                            <i class="bi bi-send"></i> Enviar Cotización
                                                        </button>
                                                    </form>
                                                </div>
                                                <div class="col-md-auto ms-auto">
                                                    <form method="post" asp-page-handler="Cancelar" class="form-cancelar">
                                                        <input type="hidden" name="idCotizacion" value="@item.IdCotizacion" />
                                                        <button type="button" class="btn-venta-outline text-danger btn-confirmar-cancelar" onclick="event.stopPropagation();">
                                                            Cancelar
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        }

                                        <!-- OPCIONES: COTIZACIÓN ENVIADA -->
                                        @if (item.Estado == "Cotización Enviada")
                                        {
                                            <div class="panel-titulo"><i class="bi bi-envelope"></i> Enviar al Cliente</div>
                                            <div class="row g-3 align-items-end mb-3">
                                                <div class="col-md-6">
                                                    <form method="post" asp-page-handler="Enviar" class="d-flex gap-2">
                                                        <input type="hidden" name="idCotizacion" value="@item.IdCotizacion" />
                                                        <input type="email" name="correoDestino" class="form-control input-panel" placeholder="Correo del cliente" required />
                                                        <button type="submit" class="btn-venta-primary text-nowrap" onclick="event.stopPropagation();">
                                                            <i class="bi bi-send"></i> Enviar por correo
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>

                                            <hr class="my-3 text-muted opacity-25" />

                                            <div class="panel-titulo"><i class="bi bi-hourglass-split"></i> Resolución del Cliente</div>
                                            <div class="d-flex gap-3">
                                                <form method="post" asp-page-handler="Rechazar">
                                                    <input type="hidden" name="idCotizacion" value="@item.IdCotizacion" />
                                                    <button type="submit" class="btn-venta-outline text-warning" onclick="event.stopPropagation();">
                                                        <i class="bi bi-arrow-return-left"></i> Cotización Rechazada
                                                    </button>
                                                </form>
                                                <form method="post" asp-page-handler="Aceptar" class="form-aceptar">
                                                    <input type="hidden" name="idCotizacion" value="@item.IdCotizacion" />
                                                    <button type="button" class="btn-venta-primary btn-confirmar-aceptar" style="background: #198754; border-color: #198754;" onclick="event.stopPropagation();">
                                                        <i class="bi bi-check-circle"></i> Cliente Aceptó (Crear Orden)
                                                    </button>
                                                </form>
                                            </div>
                                        }

                                        <!-- OPCIONES: ORDEN DE VENTA -->
                                        @if (item.Estado == "Orden de Venta")
                                        {
                                            <div class="panel-titulo"><i class="bi bi-receipt"></i> Facturación Electrónica</div>
                                            <div class="row g-3 align-items-end">
                                                <div class="col-md-auto">
                                                    <button type="button" class="btn-venta-primary"
                                                            onclick="abrirModalFacturar(
                                                        '@item.IdCotizacion',
                                                        '@item.NumeroCotizacion',
                                                        '@item.NombreCliente',
                                                        '@(item.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "N/A")',
                                                        '@item.Subtotal.ToString("N2")',
                                                        '@item.Impuesto.ToString("N2")',
                                                        '@item.Total.ToString("N2")'
                                                        )">
                                                        <i class="bi bi-receipt"></i> Proceder a Facturar
                                                    </button>
                                                </div>
                                            </div>

                                            <hr class="my-3 text-muted opacity-25" />

                                            <div class="panel-titulo"><i class="bi bi-arrow-return-left"></i> Correcciones</div>
                                            <div class="row g-3 align-items-end">
                                                <div class="col-md-auto">
                                                    <form method="post" asp-page-handler="Retroceder">
                                                        <input type="hidden" name="idCotizacion" value="@item.IdCotizacion" />
                                                        <button type="submit" class="btn-venta-outline text-secondary" onclick="event.stopPropagation(); return confirm('¿Está seguro de regresar esta orden a Cotización Enviada?');">
                                                            <i class="bi bi-arrow-return-left"></i> Retroceder a Cotización Enviada
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr id="filaVacia">
                            <td colspan="6" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-1 d-block mb-3" style="color: #b5bdc8;"></i>
                                <strong class="d-block mb-1">No hay cotizaciones activas</strong>
                                <span class="small">No existen registros pendientes por gestionar.</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL DE FACTURACIÓN -->
<div class="modal fade" id="modalFacturar" tabindex="-1" aria-labelledby="modalFacturarLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold" id="modalFacturarLabel"><i class="bi bi-receipt text-danger me-2"></i> Crear Factura</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">

                <!-- INFORMACIÓN DE LA COTIZACIÓN (SOLO LECTURA) -->
                <div class="bg-light rounded p-3 mb-4">
                    <h6 class="fw-bold text-muted small mb-3 text-uppercase">Información de la Cotización</h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small text-muted mb-1">N° Cotización</label>
                            <input type="text" class="form-control form-control-sm" id="infoNumero" disabled>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted mb-1">Cliente</label>
                            <input type="text" class="form-control form-control-sm" id="infoCliente" disabled>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-muted mb-1">Vencimiento</label>
                            <input type="text" class="form-control form-control-sm" id="infoVencimiento" disabled>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-muted mb-1">Subtotal</label>
                            <input type="text" class="form-control form-control-sm" id="infoSubtotal" disabled>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-muted mb-1">IVA</label>
                            <input type="text" class="form-control form-control-sm" id="infoImpuesto" disabled>
                        </div>
                        <div class="col-12 mt-2">
                            <label class="form-label small text-muted mb-1">Total a Facturar</label>
                            <input type="text" class="form-control form-control-lg bg-white fw-bold text-danger" id="infoTotal" disabled>
                        </div>
                    </div>
                </div>

                <!-- FORMULARIO DE FACTURACIÓN -->
                <form method="post" asp-page-handler="Facturar" class="form-facturar" id="formFacturar">
                    <input type="hidden" name="idCotizacion" id="hiddenIdCotizacion" value="" />
                    <input type="hidden" name="request.FechaFactura" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm:ss")" />

                    <h6 class="fw-bold text-muted small mb-3 text-uppercase">Datos de Facturación</h6>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Tipo Comprobante</label>
                            <select name="request.TipoFactura" class="form-select input-panel" required>
                                <option value="01">Factura Electrónica (01)</option>
                                <option value="04">Tiquete Electrónico (04)</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Condición</label>
                            <select name="request.CondicionVenta" id="modalCondicion" class="form-select input-panel" onchange="toggleTerminoModal()" required>
                                <option value="01">Contado</option>
                                <option value="02">Crédito</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Plazo / Término Pago</label>
                            <select name="request.IdTerminoPago" id="modalTermino" class="form-select input-panel">
                                <option value="">Seleccione término de pago</option>
                                @foreach (var t in Model.TerminosPago)
                                {
                                    <option value="@t.IdTerminoPago" data-dias="@t.DiasCredito" data-nombre="@t.Nombre">
                                        @t.Nombre
                                    </option>
                                }
                            </select>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-top-0 pt-0">
                <button type="button" class="btn-venta-outline" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" form="formFacturar" class="btn-venta-primary">
                    <i class="bi bi-check-circle"></i> Confirmar y Facturar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Scripts de Bootstrap (Necesario para el Modal) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    // --- CONTROL MANUAL DE LAS PESTAÑAS (ABRIR/CERRAR CON 1 CLIC) ---
    document.querySelectorAll('.fila-principal').forEach(function(fila) {
        fila.addEventListener('click', function(e) {
            // Si el clic fue en un botón o enlace interno, no hacemos nada
            if (e.target.closest('button') || e.target.closest('a')) return;

            var targetSelector = this.getAttribute('data-bs-target');
            var targetPanel = document.querySelector(targetSelector);

            if (targetPanel) {
                var collapseInstance = bootstrap.Collapse.getInstance(targetPanel);
                if (!collapseInstance) {
                    // Creamos la instancia la primera vez
                    collapseInstance = new bootstrap.Collapse(targetPanel, { toggle: false });
                }
                // Alternamos (si está cerrado abre, si está abierto cierra)
                collapseInstance.toggle();
            }
        });
    });

    // 1. Lógica para Abrir el Modal y Pasar los Datos
    function abrirModalFacturar(id, numero, cliente, vencimiento, subtotal, impuesto, total) {
        document.getElementById('infoNumero').value = numero;
        document.getElementById('infoCliente').value = cliente;
        document.getElementById('infoVencimiento').value = vencimiento;
        document.getElementById('infoSubtotal').value = '₡' + subtotal;
        document.getElementById('infoImpuesto').value = '₡' + impuesto;
        document.getElementById('infoTotal').value = '₡' + total;

        document.getElementById('hiddenIdCotizacion').value = id;

        document.getElementById('modalCondicion').value = '01';
        toggleTerminoModal();

        var myModal = new bootstrap.Modal(document.getElementById('modalFacturar'));
        myModal.show();
    }

    // 2. Habilitar temporalmente el select de término antes de enviar
    document.addEventListener('submit', function (e) {
        if (e.target && e.target.classList.contains('form-facturar')) {
            e.target.querySelectorAll('select[name="request.IdTerminoPago"]').forEach(function (sel) {
                sel.disabled = false;
            });
        }
    }, true);

    // 3. Función que controla el select de término
    function toggleTerminoModal() {
        var cond = document.getElementById('modalCondicion').value;
        var termSelect = document.getElementById('modalTermino');
        var opciones = Array.from(termSelect.querySelectorAll('option[data-nombre]'));

        termSelect.value = '';
        opciones.forEach(function (opt) { opt.hidden = false; });

        if (cond === '01') {
            var opcionContado = opciones.find(function (opt) {
                return opt.getAttribute('data-nombre').toLowerCase() === 'contado';
            });
            if (opcionContado) { termSelect.value = opcionContado.value; }
            termSelect.disabled = true;
        } else if (cond === '02') {
            termSelect.disabled = false;
            opciones.forEach(function (opt) {
                var dias = parseInt(opt.getAttribute('data-dias') || '0');
                opt.hidden = dias <= 0;
            });
            var visibles = opciones.filter(function (opt) { return !opt.hidden; });
            if (visibles.length > 0) { termSelect.value = visibles[0].value; }
        }
    }

    // 4. Confirmaciones con SweetAlert2
    document.querySelectorAll('.btn-confirmar-cancelar').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
            e.preventDefault();
            var form = this.closest('form');
            Swal.fire({
                title: '¿Está seguro?',
                text: 'Se cancelará esta cotización.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#F2382F',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, cancelar',
                cancelButtonText: 'No'
            }).then((result) => {
                if (result.isConfirmed) { form.submit(); }
            });
        });
    });

    document.querySelectorAll('.btn-confirmar-aceptar').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
            e.preventDefault();
            var form = this.closest('form');
            Swal.fire({
                title: '¿Confirmar aceptación?',
                text: 'Se creará una Orden de Venta a partir de esta cotización.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#198754',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, crear orden',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) { form.submit(); }
            });
        });
    });
</script>