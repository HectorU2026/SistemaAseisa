@page
@model Web.Pages.Ventas.VentasModel
@{
    ViewData["Title"] = "Ventas";
}

<link rel="stylesheet" href="~/css/ventas.css" asp-append-version="true" />

<div class="container mt-4 mb-5 ventas-page">

    <!-- ENCABEZADO -->
    <div class="ventas-header">
        <div>
            <div class="ventas-breadcrumb">
                <i class="bi bi-cart3"></i>
                <span>Gestión comercial / Ventas</span>
            </div>
            <h1>Ventas</h1>
            <p>Administre sus cotizaciones y órdenes de venta activas.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/Ventas/Crear" class="btn-venta-primary shadow-sm">
                <i class="bi bi-plus-lg"></i> Nueva Cotización
            </a>
        </div>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- FILTROS -->
        <!-- FILTROS -->
    <form method="get" class="ventas-filtros">
        <div class="ventas-search">
            <i class="bi bi-search"></i>
            <!-- Mantenemos el valor si ya se buscó algo -->
            <input type="text" name="busqueda" value="@Request.Query["busqueda"]" placeholder="Buscar por número o cliente..." />
        </div>
        
        <select name="idEstado" class="form-select">
            <option value="">Todos los estados activos</option>
            <option value="1" selected="@(Request.Query["idEstado"] == "1")">Cotización</option>
            <option value="2" selected="@(Request.Query["idEstado"] == "2")">Cotización Enviada</option>
            <option value="3" selected="@(Request.Query["idEstado"] == "3")">Orden de Venta</option>
        </select>

        <button type="submit" class="btn-venta-primary">
            <i class="bi bi-funnel"></i> Filtrar
        </button>
        
        <a href="/Ventas/Ventas" class="btn-venta-outline">Limpiar</a>

        <a href="/Ventas/ventas_canceladas" class="btn-venta-outline ms-auto text-danger" style="border-color: #dc3545;">
            <i class="bi bi-x-circle"></i> Canceladas
        </a>
    </form>

    <!-- TABLA -->
    <div class="ventas-panel">
        <div class="table-responsive">
            <table class="table ventas-table align-middle">
                <thead>
                    <tr>
                        <th>Cotización</th>
                        <th>Cliente</th>
                        <th>Vencimiento</th>
                        <th class="text-end">Total</th>
                        <th class="text-center">Estado</th>
                    </tr>
                </thead>
                <tbody id="tbodyVentas">
                    @if (Model.Cotizaciones != null && Model.Cotizaciones.Any())
                    {
                        foreach (var item in Model.Cotizaciones)
                        {
                            string badgeClass = "bg-cotizacion";
                            if (item.Estado == "Cotización Enviada") badgeClass = "bg-enviada";
                            else if (item.Estado == "Orden de Venta") badgeClass = "bg-orden";

                            <!-- FILA CLICKEABLE -->
                            <tr class="fila-principal"
                                data-numero="@item.NumeroCotizacion.ToLower()"
                                data-cliente="@item.NombreCliente.ToLower()"
                                data-estado="@item.Estado"
                                data-bs-toggle="collapse"
                                data-bs-target="#panel-@item.IdCotizacion"
                                aria-expanded="false">
                                <td class="fw-bold text-dark">@item.NumeroCotizacion</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background: #fff0ef; color: #F2382F; font-weight: bold;">
                                            @item.NombreCliente.Substring(0, 1).ToUpper()
                                        </div>
                                        <span class="fw-semibold text-secondary">@item.NombreCliente</span>
                                    </div>
                                </td>
                                <td class="text-muted small">@(item.FechaVencimiento?.ToString("dd MMM, yyyy") ?? "-")</td>
                                <td class="text-end fw-bold text-dark">@item.Total.ToString("C")</td>
                                <td class="text-center">
                                    <span class="badge-venta @badgeClass">@item.Estado</span>
                                </td>
                            </tr>

                            <!-- PANEL DESPLEGABLE -->
                            <tr class="collapse fila-panel" id="panel-@item.IdCotizacion">
                                <td colspan="5">
                                    <div class="panel-contenido">

                                        <!-- OPCIONES: COTIZACIÓN -->
                                        @if (item.Estado == "Cotización")
                                        {
                                            <div class="panel-titulo"><i class="bi bi-pencil-square"></i> Acciones para Cotización</div>
                                            <div class="row g-3 align-items-end">
                                                <div class="col-md-auto">
                                                    <a href="/Ventas/Editar/@item.IdCotizacion" class="btn-venta-outline w-100">
                                                        <i class="bi bi-pencil"></i> Editar
                                                    </a>
                                                </div>
                                                <div class="col-md-5">
                                                    <form method="post" asp-page-handler="Enviar" class="d-flex gap-2">
                                                        <input type="hidden" name="idCotizacion" value="@item.IdCotizacion" />
                                                        <input type="email" name="correoDestino" class="form-control input-panel" placeholder="Correo del cliente" required />
                                                        <button type="submit" class="btn-venta-primary text-nowrap" onclick="event.stopPropagation();">
                                                            <i class="bi bi-send"></i> Enviar
                                                        </button>
                                                    </form>
                                                </div>
                                                <div class="col-md-auto ms-auto">
                                                    <form method="post" asp-page-handler="Cancelar">
                                                        <input type="hidden" name="idCotizacion" value="@item.IdCotizacion" />
                                                        <button type="submit" class="btn-venta-outline text-danger" onclick="event.stopPropagation(); return confirm('¿Está seguro de cancelar esta cotización?');">
                                                            Cancelar
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        }

                                        <!-- OPCIONES: COTIZACIÓN ENVIADA -->
                                        @if (item.Estado == "Cotización Enviada")
                                        {
                                            <div class="panel-titulo"><i class="bi bi-hourglass-split"></i> Cotización enviada al cliente</div>
                                            <div class="d-flex gap-3">
                                                <form method="post" asp-page-handler="Rechazar">
                                                    <input type="hidden" name="idCotizacion" value="@item.IdCotizacion" />
                                                    <button type="submit" class="btn-venta-outline text-warning" onclick="event.stopPropagation();">
                                                        <i class="bi bi-arrow-return-left"></i> Solicitar Cambios
                                                    </button>
                                                </form>
                                                <form method="post" asp-page-handler="Aceptar">
                                                    <input type="hidden" name="idCotizacion" value="@item.IdCotizacion" />
                                                    <button type="submit" class="btn-venta-primary" style="background: #198754; border-color: #198754;" onclick="event.stopPropagation();">
                                                        <i class="bi bi-check-circle"></i> Cliente Aceptó (Crear Orden)
                                                    </button>
                                                </form>
                                            </div>
                                        }

                                        <!-- OPCIONES: ORDEN DE VENTA (FACTURACIÓN Y RETROCESO) -->
                                        @if (item.Estado == "Orden de Venta")
                                        {
                                            <div class="panel-titulo"><i class="bi bi-receipt"></i> Facturación Electrónica</div>

                                            <form method="post" asp-page-handler="Facturar">
                                                <input type="hidden" name="idCotizacion" value="@item.IdCotizacion" />
                                                <input type="hidden" name="request.FechaFactura" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm:ss")" />

                                                <div class="row g-3 align-items-end">
                                                    <div class="col-md-3">
                                                        <label class="panel-label">Tipo Comprobante</label>
                                                        <select name="request.TipoFactura" class="form-select input-panel" required>
                                                            <option value="01">Factura Electrónica (01)</option>
                                                            <option value="04">Tiquete Electrónico (04)</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-2">
                                                        <label class="panel-label">Condición</label>
                                                        <select name="request.CondicionVenta" id="cond-@item.IdCotizacion" class="form-select input-panel" onchange="toggleTermino(this, @item.IdCotizacion)" required>
                                                            <option value="01">Contado</option>
                                                            <option value="02">Crédito</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <label class="panel-label">Plazo / Término Pago</label>
                                                        <select name="request.IdTerminoPago" id="term-@item.IdCotizacion" class="form-select input-panel" disabled>
                                                            <option value="">No aplica</option>
                                                            @foreach (var t in Model.TerminosPago)
                                                            {
                                                                <option value="@t.IdTerminoPago">@t.Nombre</option>
                                                            }
                                                        </select>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <button type="submit" class="btn-venta-primary w-100" onclick="event.stopPropagation();">
                                                            Confirmar y Facturar
                                                        </button>
                                                    </div>
                                                </div>
                                            </form>

                                            <!-- BOTÓN RETROCEDER -->
                                            <div class="mt-3 pt-3 border-top" style="border-color: #e2e5eb !important;">
                                                <form method="post" asp-page-handler="Retroceder">
                                                    <input type="hidden" name="idCotizacion" value="@item.IdCotizacion" />
                                                    <button type="submit" class="btn-venta-outline text-secondary" onclick="event.stopPropagation(); return confirm('¿Está seguro de regresar esta orden a Cotización Enviada?');">
                                                        <i class="bi bi-arrow-return-left"></i> Retroceder a Cotización Enviada
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr id="filaVacia">
                            <td colspan="5" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-1 d-block mb-3" style="color: #b5bdc8;"></i>
                                <strong class="d-block mb-1">No hay cotizaciones activas</strong>
                                <span class="small">No existen registros pendientes por gestionar.</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    // --- Lógica del Toggle de Término de Pago (Facturación) ---
    function toggleTermino(selectCondicion, id) {
        var cond = selectCondicion.value;
        var termSelect = document.getElementById('term-' + id);
        if (cond === '01') {
            termSelect.value = '';
            termSelect.disabled = true;
        } else {
            termSelect.disabled = false;
        }
    }
</script>