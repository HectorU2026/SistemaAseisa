@page
@model Web.Pages.Ventas.ventas_canceladasModel
@{
    ViewData["Title"] = "Cotizaciones Canceladas";
}

<link rel="stylesheet" href="~/css/ventas.css" asp-append-version="true" />

<div class="container mt-4 mb-5 ventas-page">

    <!-- ENCABEZADO -->
    <div class="ventas-header">
        <div>
            <div class="ventas-breadcrumb">
                <i class="bi bi-x-circle"></i>
                <span>Gestión comercial / Ventas / Canceladas</span>
            </div>
            <h1>Cotizaciones Canceladas</h1>
            <p>Historial de negociaciones que no prosperaron.</p>
        </div>
        <a href="/Ventas/Ventas" class="btn-venta-outline shadow-sm">
            <i class="bi bi-arrow-left"></i> Volver a Ventas
        </a>
    </div>

    <!-- FILTROS -->
    <form method="get" class="ventas-filtros">
        <div class="ventas-search">
            <i class="bi bi-search"></i>
            <input type="text" name="busqueda" value="@Request.Query["busqueda"]" placeholder="Buscar por cliente o número..." />
        </div>
        <div class="col-md-3">
            <input type="date" name="fecha" value="@Request.Query["fecha"]" class="form-control input-panel" style="background: white;" title="Fecha de cancelación" />
        </div>
        <button type="submit" class="btn-venta-primary">
            <i class="bi bi-funnel"></i> Filtrar
        </button>
        <a href="/Ventas/ventas_canceladas" class="btn-venta-outline">Limpiar</a>
    </form>

    <!-- TABLA -->
    <div class="ventas-panel">
        <div class="table-responsive">
            <table class="table ventas-table align-middle">
                <thead>
                    <tr>
                        <th>Cotización</th>
                        <th>Cliente</th>
                        <th>Vencimiento</th>
                        <th class="text-end">Total</th>
                        <th>Fecha Cancelación</th>
                        <th class="text-center">Estado</th>
                    </tr>
                </thead>
                <tbody id="tbodyCanceladas">
                    @if (Model.Cotizaciones != null && Model.Cotizaciones.Any())
                    {
                        foreach (var item in Model.Cotizaciones)
                        {
                            string badgeClass = item.NombreEstado == "Cancelada" ? "bg-cancelada" : "bg-enviada";

                            <!-- FILA PRINCIPAL -->
                            <tr class="fila-principal"
                                data-bs-toggle="collapse"
                                data-bs-target="#panel-@item.IdCotizacion"
                                aria-expanded="false">

                                <td class="fw-bold text-dark">@item.NumeroCotizacion</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background: #fff0ef; color: #F2382F; font-weight: bold;">
                                            @item.NombreRazonSocial.Substring(0, 1).ToUpper()
                                        </div>
                                        <span class="fw-semibold text-secondary">@item.NombreRazonSocial</span>
                                    </div>
                                </td>
                                <td class="text-muted small">@(item.FechaVencimiento?.ToString("dd MMM, yyyy") ?? "-")</td>
                                <td class="text-end fw-bold text-dark">@item.Total.ToString("C")</td>
                                <td class="text-muted small">@item.FechaEmision.ToString("dd MMM, yyyy")</td>
                                <td class="text-center">
                                    <span class="badge-venta @badgeClass">@item.NombreEstado</span>
                                </td>
                            </tr>

                            <!-- PANEL DESPLEGABLE -->
                            <tr class="collapse fila-panel" id="panel-@item.IdCotizacion">
                                <td colspan="6">
                                    <div class="panel-contenido">

                                        <div class="row g-3 mb-4">
                                            <div class="col-md-6">
                                                <p class="panel-label mb-1">Cliente</p>
                                                <p class="fw-bold mb-0">@item.NombreRazonSocial</p>
                                            </div>
                                            <div class="col-md-3">
                                                <p class="panel-label mb-1">Vencimiento</p>
                                                <p class="fw-bold mb-0">@(item.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "-")</p>
                                            </div>
                                            <div class="col-md-3">
                                                <p class="panel-label mb-1">Fecha Cancelación</p>
                                                <p class="fw-bold mb-0 text-danger">@item.FechaEmision.ToString("dd/MM/yyyy")</p>
                                            </div>
                                        </div>

                                        <h6 class="panel-titulo border-bottom pb-2 mb-3">
                                            <i class="bi bi-box-seam"></i> Productos
                                        </h6>

                                        <div class="table-responsive">
                                            <table class="table table-sm align-middle mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th class="text-muted small fw-semibold">Producto</th>
                                                        <th class="text-muted small fw-semibold text-end">Cantidad</th>
                                                        <th class="text-muted small fw-semibold text-end">Subtotal</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (item.Detalles != null && item.Detalles.Any())
                                                    {
                                                        foreach (var detalle in item.Detalles)
                                                        {
                                                            <tr>
                                                                <td class="fw-semibold text-dark">@detalle.NombreProducto</td>
                                                                <td class="text-end text-muted">@detalle.Cantidad</td>
                                                                <td class="text-end fw-bold">@detalle.Subtotal.ToString("C")</td>
                                                            </tr>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <tr>
                                                            <td colspan="3" class="text-center text-muted py-3">No hay productos registrados.</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>

                                        <div class="mt-4 text-end">
                                            <p class="panel-label mb-1">Monto Total</p>
                                            <h4 class="fw-bold mb-0">@item.Total.ToString("C")</h4>
                                        </div>

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr id="filaVacia">
                            <td colspan="6" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-1 d-block mb-3" style="color: #b5bdc8;"></i>
                                <strong class="d-block mb-1">No hay cotizaciones canceladas</strong>
                                <span class="small">No existen registros que coincidan con los filtros.</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>