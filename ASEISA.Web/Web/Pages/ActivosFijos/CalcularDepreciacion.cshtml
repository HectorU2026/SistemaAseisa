@page
@model Web.Pages.ActivosFijos.CalcularDepreciacionModel
@{
    ViewData["Title"] = "Calcular Depreciación";
}

<div class="container mt-4 mb-5" style="max-width: 600px;">

    <div class="d-flex align-items-center gap-3 mb-4">
        <a href="/ActivosFijos/Listado@(Model.Calculo.IdActivoFijo.HasValue ? $"?IdActivoFijo={Model.Calculo.IdActivoFijo}" : "")"
           class="btn btn-light border shadow-sm rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
            <i class="bi bi-arrow-left text-secondary"></i>
        </a>
        <div>
            <h1 class="h3 fw-bold mb-0 text-dark">Calcular depreciación</h1>
            <p class="text-muted small mb-0">Ejecute el cálculo de depreciación mensual para un activo fijo.</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.MensajeError))
    {
        <div class="alert alert-danger border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.MensajeError
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form method="post">

                <div class="mb-4">
                    <label asp-for="Calculo.IdActivoFijo" class="form-label small fw-semibold">ID del Activo Fijo <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted"><i class="bi bi-hash"></i></span>
                        <input asp-for="Calculo.IdActivoFijo" type="number" min="1" class="form-control border-start-0" placeholder="Ej. 1" required />
                    </div>
                    <span asp-validation-for="Calculo.IdActivoFijo" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Calculo.Periodo" class="form-label small fw-semibold">Periodo a depreciar (Año - Mes) <span class="text-danger">*</span></label>
                    <input asp-for="Calculo.Periodo" type="month" class="form-control" required />
                    <span asp-validation-for="Calculo.Periodo" class="text-danger small"></span>
                    <div class="form-text small text-muted">Se registrará en formato AAAA-MM (ej. @DateTime.Now.ToString("yyyy-MM")).</div>
                </div>

                <div class="mt-4 pt-4 border-top d-flex justify-content-end gap-2">
                    <a href="/ActivosFijos/Listado@(Model.Calculo.IdActivoFijo.HasValue ? $"?IdActivoFijo={Model.Calculo.IdActivoFijo}" : "")"
                       class="btn btn-light border fw-semibold">Cancelar</a>
                    <button type="submit" class="btn text-white fw-semibold" style="background-color: #F2382F;">Calcular Depreciación</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}