@page "{id:int}"
@model Web.Pages.Usuarios.DetalleModel
@{ViewData["Title"]="Detalle de usuario";var nombre=$"{Model.Usuario.Nombre} {Model.Usuario.PrimerApellido}";}
<link rel="stylesheet" href="~/css/contactos.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/usuarios.css" asp-append-version="true" />
<div class="contactos-page usuarios-page">
 <div class="contactos-header"><div><div class="contactos-breadcrumb"><a asp-page="Index">Usuarios</a> / Detalle</div><h1>@nombre</h1><p>@Model.Usuario.NombreUsuario · @Model.Usuario.Correo</p></div><a asp-page="Index" class="btn btn-contacto-outline"><i class="bi bi-arrow-left"></i> Volver al listado</a></div>
 @if(TempData["Mensaje"] is string mensaje){<div class="alert alert-success" role="status">@mensaje</div>}
 <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
 <div class="usuario-resumen"><span class="badge @(Model.Usuario.EstadoAprobacion=="Aprobado"?"bg-success":Model.Usuario.EstadoAprobacion=="Pendiente"?"bg-warning text-dark":"bg-danger")">@Model.Usuario.EstadoAprobacion</span><span class="badge @(Model.Estado=="Activo"?"bg-success":"bg-secondary")">@Model.Estado</span></div>
 <div class="row g-4"><div class="col-xl-8"><section class="contactos-panel usuarios-panel"><h2><i class="bi bi-person"></i> Datos personales</h2>
 <form method="post" asp-page-handler="Editar" data-formulario-usuario><div class="row g-3"><div class="col-md-6"><label asp-for="Datos.Nombre" maxlength="80" class="form-label">Nombre *</label><input asp-for="Datos.Nombre" maxlength="80" class="form-control" /><span asp-validation-for="Datos.Nombre"></span></div>
<div class="col-md-6"><label asp-for="Datos.PrimerApellido" maxlength="80" class="form-label">Primer apellido *</label><input asp-for="Datos.PrimerApellido" maxlength="80" class="form-control" /><span asp-validation-for="Datos.PrimerApellido"></span></div>
<div class="col-md-6"><label asp-for="Datos.SegundoApellido" maxlength="80" class="form-label">Segundo apellido</label><input asp-for="Datos.SegundoApellido" maxlength="80" class="form-control" /><span asp-validation-for="Datos.SegundoApellido"></span></div>
<div class="col-md-6"><label asp-for="Datos.Correo" maxlength="150" class="form-label">Correo electrónico *</label><input asp-for="Datos.Correo" maxlength="150" type="email" class="form-control" /><span asp-validation-for="Datos.Correo"></span></div>
<div class="col-md-6"><label asp-for="Datos.NombreUsuario" class="form-label">Nombre de usuario</label><input asp-for="Datos.NombreUsuario" class="form-control" readonly aria-describedby="usuario-inmutable" /><span asp-validation-for="Datos.NombreUsuario"></span></div>
</div><p id="usuario-inmutable" class="text-muted mt-3">El nombre de usuario es permanente. Editar los datos personales no lo regenera.</p><button class="btn btn-contacto-primary"><i class="bi bi-check2"></i> Guardar datos</button></form></section>
 <section class="contactos-panel usuarios-panel"><h2><i class="bi bi-person-badge"></i> Roles activos</h2>
 @if(Model.Usuario.Roles.Count==0){<div class="alert alert-warning">El usuario no tiene roles activos y no puede iniciar sesión.</div>}
 @if(Model.Usuario.Roles.Select(r=>r.IdRol).Distinct().Count()==1){<p class="alert alert-info">El usuario debe conservar al menos un rol activo. Agregue otro antes de retirar el actual.</p>}
 <ul class="list-group list-group-flush mb-3">@foreach(var r in Model.Usuario.Roles.OrderBy(r=>r.NombreRol)){<li class="list-group-item d-flex flex-wrap gap-2 justify-content-between align-items-center px-0"><span class="usuario-rol">@r.NombreRol</span>
 @if(Model.Usuario.EstadoAprobacion=="Aprobado"){<button type="button" class="btn btn-sm btn-outline-danger" disabled="@(Model.Usuario.Roles.Select(x=>x.IdRol).Distinct().Count()<=1)" data-bs-toggle="modal" data-bs-target="#confirmarAcceso" data-accion="retirar" data-rol="@r.IdRol" data-descripcion="Retirar el rol @r.NombreRol de @nombre. Perderá los permisos asociados a ese rol."><i class="bi bi-person-dash"></i> Retirar rol</button>}</li>}</ul>
 @if(Model.Usuario.EstadoAprobacion=="Aprobado"){
 <form method="post" asp-page-handler="Accion" class="d-flex gap-2"><select name="rol" id="rolParaAgregar" class="form-select" required aria-label="Rol para agregar"><option value="">Seleccione un rol disponible</option>@foreach(var r in Model.Catalogos.Roles.Where(r=>!Model.Usuario.Roles.Any(a=>a.IdRol==r.Id)).OrderBy(r=>r.Nombre)){<option value="@r.Id">@r.Nombre</option>}</select><button type="button" class="btn btn-contacto-primary text-nowrap" data-bs-toggle="modal" data-bs-target="#confirmarAcceso" data-accion="agregar" data-selector="rolParaAgregar" data-descripcion="Agregar el rol seleccionado a @nombre. Se habilitarán sus permisos sin retirar otros roles."><i class="bi bi-person-plus"></i> Agregar rol</button></form>}
 <p class="text-muted mt-3 mb-0">Agregar o retirar un rol conserva las demás asignaciones.</p></section></div>
 <div class="col-xl-4"><section class="contactos-panel usuarios-panel"><h2><i class="bi bi-shield-lock"></i> Acceso y aprobación</h2><div class="d-flex flex-column gap-2">
 @if(Model.Usuario.EstadoAprobacion=="Pendiente"){
 <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#confirmarAcceso" data-accion="aprobacion" data-valor="true" data-descripcion="Aprobar la solicitud de @nombre y habilitar su acceso.">Aprobar solicitud</button>
 <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#confirmarAcceso" data-accion="aprobacion" data-valor="false" data-descripcion="Rechazar la solicitud de @nombre. No podrá iniciar sesión.">Rechazar solicitud</button>}
 @if(Model.Usuario.EstadoAprobacion=="Aprobado" && (Model.Estado=="Activo" || Model.Estado=="Inactivo")){
 <button type="button" class="btn @(Model.Estado=="Activo"?"btn-outline-danger":"btn-contacto-outline")" data-bs-toggle="modal" data-bs-target="#confirmarAcceso" data-accion="estado" data-valor="@(Model.Estado=="Activo"?"false":"true")" data-descripcion="@(Model.Estado=="Activo"?$"Desactivar a {nombre}. Sus sesiones dejarán de tener acceso.":$"Activar el acceso de {nombre}.")"><i class="bi @(Model.Estado=="Activo"?"bi-person-lock":"bi-person-check")"></i> @(Model.Estado=="Activo"?"Desactivar usuario":"Activar usuario")</button>
 @if(Model.Estado=="Activo"){<button type="button" class="btn btn-contacto-outline" data-bs-toggle="modal" data-bs-target="#confirmarAcceso" data-accion="restablecer" data-descripcion="Programar un enlace para que @nombre establezca su contraseña. Los enlaces anteriores quedarán invalidados."><i class="bi bi-envelope"></i> Enviar enlace de contraseña</button>}}
 @if(Model.Usuario.EstadoAprobacion=="Rechazado"){<p class="text-muted">La solicitud fue rechazada. No hay transiciones de aprobación disponibles para este estado.</p>}
 </div></section></div></div>
 <div class="modal fade" id="confirmarAcceso" tabindex="-1" aria-labelledby="tituloConfirmacion" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5" id="tituloConfirmacion">Confirmar cambio de acceso</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div><div class="modal-body"><p id="descripcionAcceso"></p><p class="text-muted mb-0">La operación será registrada en la bitácora.</p></div><div class="modal-footer"><button type="button" class="btn btn-contacto-outline" data-bs-dismiss="modal"><i class="bi bi-x-lg"></i> Cancelar</button><form method="post" asp-page-handler="Accion"><input type="hidden" name="accion" id="accionAcceso" /><input type="hidden" name="valor" id="valorAcceso" /><input type="hidden" name="rol" id="rolAcceso" /><button class="btn btn-contacto-primary"><i class="bi bi-check2"></i> Confirmar</button></form></div></div></div></div>
</div>
@section Scripts {<partial name="_ValidationScriptsPartial" /><script src="~/js/registro-campos.js" asp-append-version="true"></script><script src="~/js/usuarios-formulario.js" asp-append-version="true"></script><script src="~/js/usuarios.js" asp-append-version="true"></script>}