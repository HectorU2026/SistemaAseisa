@page
@model Web.Pages.MetodoPago.Listado_MetodoPagoModel

@{
    ViewData["Title"] = "Listado de métodos de pago";

    int total = Model.MetodosPago.Count;
    int activos = Model.MetodosPago.Count(t => t.Activo);
    int inactivos = Model.MetodosPago.Count(t => !t.Activo);
}

<link rel="stylesheet"
      href="~/css/contactos.css"
      asp-append-version="true" />

<div class="contactos-page">

    <!-- Encabezado -->
    <div class="contactos-header">
        <div>
            <div class="contactos-breadcrumb">
                <i class="bi bi-credit-card"></i>
                <span>Configuración / Métodos de pago</span>
            </div>

            <h1>Métodos de pago</h1>

            <p>
                Administre los métodos de pago
                registrados en ASEISA.
            </p>
        </div>

        <a asp-page="/MetodoPago/Agregar_MetodoPago"
           class="btn btn-contacto-primary">
            <i class="bi bi-plus-lg"></i>
            Nuevo método
        </a>
    </div>

    <!-- Mensajes -->
    @if (TempData["MensajeExito"] is string mensaje)
    {
        <div class="alert alert-success" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @mensaje
        </div>
    }

    @if (TempData["MensajeError"] is string mensajeError)
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @mensajeError
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.MensajeError))
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @Model.MensajeError
        </div>
    }

    <!-- Estadísticas -->
    <div class="contactos-stats">

        <div class="contacto-stat">
            <div class="stat-icon">
                <i class="bi bi-list-check"></i>
            </div>
            <div>
                <span>Total de métodos</span>
                <strong>@total</strong>
            </div>
        </div>

        <div class="contacto-stat">
            <div class="stat-icon">
                <i class="bi bi-check-circle"></i>
            </div>
            <div>
                <span>Métodos activos</span>
                <strong>@activos</strong>
            </div>
        </div>

        <div class="contacto-stat">
            <div class="stat-icon">
                <i class="bi bi-x-circle"></i>
            </div>
            <div>
                <span>Métodos inactivos</span>
                <strong>@inactivos</strong>
            </div>
        </div>

    </div>

    <!-- Panel principal -->
    <section class="contactos-panel">

        <div class="contactos-panel-header">
            <div>
                <h2>Listado de métodos de pago</h2>
                <p>
                    Consulte y filtre los métodos de pago
                    de la empresa.
                </p>
            </div>

            <span class="contactos-count">
                @total registros
            </span>
        </div>

        <!-- Filtros -->
        <form method="get" class="contactos-filtros">

            <div class="contactos-search">
                <i class="bi bi-search"></i>

                <input type="text"
                       name="Busqueda"
                       value="@Model.Busqueda"
                       placeholder="Buscar por nombre..."
                       aria-label="Buscar métodos de pago" />
            </div>

            <select name="Estado"
                    class="form-select"
                    aria-label="Filtrar por estado">

                <option value="">Todos los estados</option>

                <option value="Activo"
                        selected="@(Model.Estado == "Activo")">
                    Activo
                </option>

                <option value="Inactivo"
                        selected="@(Model.Estado == "Inactivo")">
                    Inactivo
                </option>
            </select>

            <button type="submit"
                    class="btn btn-contacto-primary">
                <i class="bi bi-funnel"></i>
                Filtrar
            </button>

            <a asp-page="/MetodoPago/Listado_MetodoPago"
               class="btn btn-contacto-outline">
                Limpiar
            </a>

        </form>

        <!-- Tabla -->
        <div class="table-responsive">

            <table class="table contactos-table align-middle">

                <thead>
                    <tr>
                        <th>Método de pago</th>
                        <th>Estado</th>
                        <th>Fecha de creación</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @if (!Model.MetodosPago.Any())
                    {
                        <tr>
                            <td colspan="4" class="contactos-empty">
                                <i class="bi bi-inbox"></i>

                                <strong>
                                    No se encontraron métodos de pago
                                </strong>

                                <span>
                                    No hay registros que coincidan
                                    con los filtros seleccionados.
                                </span>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var metodo in Model.MetodosPago)
                        {
                            <tr>
                                <td>
                                    <div class="contacto-info">

                                        <div class="contacto-avatar">
                                            <i class="bi bi-credit-card"></i>
                                        </div>

                                        <div>
                                            <strong>@metodo.Nombre</strong>

                                        </div>

                                    </div>
                                </td>

                                <td>
                                    <span class="contacto-estado @(metodo.Activo ? "activo" : "inactivo")">
                                        <span class="estado-punto"></span>
                                        @(metodo.Activo ? "Activo" : "Inactivo")
                                    </span>
                                </td>

                                <td>
                                    @metodo.FechaCreacion.ToString("dd/MM/yyyy")
                                </td>

                                <td class="text-end">

                                    <div class="d-inline-flex align-items-center gap-1">

                                        <a asp-page="/MetodoPago/Editar_MetodoPago"
                                           asp-route-idMetodoPago="@metodo.IdMetodoPago"
                                           class="btn btn-contacto-action"
                                           title="Editar método de pago"
                                           aria-label="Editar @metodo.Nombre">

                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        @if (metodo.Activo)
                                        {
                                            <button type="button"
                                                    class="btn btn-contacto-estado btn-contacto-desactivar"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalCambiarEstado"
                                                    data-metodo-id="@metodo.IdMetodoPago"
                                                    data-metodo-nombre="@metodo.Nombre"
                                                    data-metodo-accion="Desactivar">

                                                <i class="bi bi-x-circle"></i>
                                                Desactivar
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn btn-contacto-estado btn-contacto-activar"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalCambiarEstado"
                                                    data-metodo-id="@metodo.IdMetodoPago"
                                                    data-metodo-nombre="@metodo.Nombre"
                                                    data-metodo-accion="Activar">

                                                <i class="bi bi-check-circle"></i>
                                                Activar
                                            </button>
                                        }

                                    </div>

                                </td>
                            </tr>
                        }
                    }

                </tbody>

            </table>
        </div>

        <div class="contactos-footer">
            Mostrando @total métodos de pago
        </div>

    </section>
</div>

<!-- Modal de confirmación -->
<div class="modal fade"
     id="modalCambiarEstado"
     tabindex="-1"
     aria-labelledby="modalCambiarEstadoTitulo"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content contacto-modal">

            <div class="modal-body text-center">

                <div class="contacto-modal-icono"
                     id="modalEstadoIcono">
                    <i class="bi bi-x-circle"></i>
                </div>

                <h3 id="modalCambiarEstadoTitulo">
                    ¿Desactivar método de pago?
                </h3>

                <p class="contacto-modal-descripcion">
                    ¿Está seguro de que desea
                    <span id="modalEstadoAccionTexto">
                        desactivar
                    </span>
                    el método
                    <strong id="modalEstadoNombre"></strong>?
                </p>

                <p class="contacto-modal-ayuda"
                   id="modalEstadoAyuda">
                    Podrá volver a activar este método
                    cuando lo necesite.
                </p>

                <form method="post" id="formCambiarEstado">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="idMetodoPago"
                           id="modalEstadoIdMetodoPago" />

                    <div class="contacto-modal-acciones">

                        <button type="button"
                                class="btn btn-contacto-outline"
                                data-bs-dismiss="modal">
                            Cancelar
                        </button>

                        <button type="submit"
                                class="btn btn-contacto-confirmar"
                                id="modalEstadoConfirmar">

                            <i class="bi bi-x-circle"></i>
                            <span>Desactivar</span>
                        </button>

                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const modal = document.getElementById("modalCambiarEstado");

        if (!modal) return;

        modal.addEventListener("show.bs.modal", function (event) {

            const boton = event.relatedTarget;

            if (!boton) return;

            const idMetodo = boton.getAttribute("data-metodo-id");
            const nombre = boton.getAttribute("data-metodo-nombre");
            const accion = boton.getAttribute("data-metodo-accion");

            const activar = accion === "Activar";

            const formulario = document.getElementById("formCambiarEstado");
            const titulo = document.getElementById("modalCambiarEstadoTitulo");
            const nombreElemento = document.getElementById("modalEstadoNombre");
            const accionTexto = document.getElementById("modalEstadoAccionTexto");
            const ayuda = document.getElementById("modalEstadoAyuda");
            const icono = document.getElementById("modalEstadoIcono");
            const confirmar = document.getElementById("modalEstadoConfirmar");

            document.getElementById("modalEstadoIdMetodoPago").value = idMetodo;

            titulo.textContent = activar
                ? "¿Activar método de pago?"
                : "¿Desactivar método de pago?";

            nombreElemento.textContent = nombre;

            accionTexto.textContent = activar
                ? "activar"
                : "desactivar";

            ayuda.textContent = activar
                ? "Este método volverá a estar disponible para las operaciones correspondientes."
                : "Podrá volver a activar este método cuando lo necesite.";

            const url = new URL(window.location.href);
            url.searchParams.set("handler", accion);

            formulario.action = url.pathname + url.search;

            icono.className = activar
                ? "contacto-modal-icono activar"
                : "contacto-modal-icono desactivar";

            icono.innerHTML = activar
                ? '<i class="bi bi-check-circle"></i>'
                : '<i class="bi bi-x-circle"></i>';

            confirmar.className = activar
                ? "btn btn-contacto-confirmar activar"
                : "btn btn-contacto-confirmar desactivar";

            confirmar.querySelector("span").textContent = accion;

            confirmar.querySelector("i").className = activar
                ? "bi bi-check-circle"
                : "bi bi-x-circle";
        });

        document.getElementById("formCambiarEstado")
            .addEventListener("submit", function () {

                const boton = document.getElementById("modalEstadoConfirmar");
                boton.disabled = true;
            });
    });
</script>
