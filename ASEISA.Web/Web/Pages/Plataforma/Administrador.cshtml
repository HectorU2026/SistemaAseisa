@page "{empresa:int}/{id:int?}"
@model Web.Pages.Plataforma.AdministradorModel
@{ViewData["Title"]="Administrador de empresa";var existe=Model.Usuario!=null;}
<link rel="stylesheet" href="~/css/contactos.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/usuarios.css" asp-append-version="true" />
<div class="contactos-page usuarios-page"><div class="contactos-header"><div><div class="contactos-breadcrumb"><a asp-page="Empresas">Plataforma</a> / Administrador</div><h1>@(existe?"Administrar cuenta":"Nuevo administrador")</h1><p>@Model.Empresa.RazonSocial · @Model.Empresa.Estado</p></div><a asp-page="Empresa" asp-route-id="@Model.Empresa.IdEmpresa" class="btn btn-contacto-outline"><i class="bi bi-arrow-left"></i> Volver a empresa</a></div>
<div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>@if(TempData["Mensaje"] is string mensaje){<div class="alert alert-success" role="status">@mensaje</div>}
<section class="contactos-panel usuarios-panel"><form method="post" asp-page-handler="Guardar" data-formulario-usuario><div class="row g-3">
@if(existe){<div class="col-md-6"><label asp-for="Edicion.Nombre" class="form-label">Nombre *</label><input asp-for="Edicion.Nombre" class="form-control" /><span asp-validation-for="Edicion.Nombre"></span></div>
<div class="col-md-6"><label asp-for="Edicion.PrimerApellido" class="form-label">Primer apellido *</label><input asp-for="Edicion.PrimerApellido" class="form-control" /><span asp-validation-for="Edicion.PrimerApellido"></span></div>
<div class="col-md-6"><label asp-for="Edicion.SegundoApellido" class="form-label">Segundo apellido</label><input asp-for="Edicion.SegundoApellido" class="form-control" /><span asp-validation-for="Edicion.SegundoApellido"></span></div>
<div class="col-md-6"><label asp-for="Edicion.Correo" class="form-label">Correo *</label><input asp-for="Edicion.Correo" class="form-control" /><span asp-validation-for="Edicion.Correo"></span></div>
<div class="col-md-6"><label class="form-label" for="nombreUsuario">Nombre de usuario</label><input id="nombreUsuario" value="@Model.Usuario!.NombreUsuario" class="form-control" readonly /></div>
}else{
<div class="col-md-6"><label asp-for="Alta.TipoCliente" class="form-label">Tipo de identificación *</label><select asp-for="Alta.TipoCliente" class="form-select"><option>Persona física</option><option>Persona jurídica</option></select><span asp-validation-for="Alta.TipoCliente"></span></div><div class="col-md-6"><label asp-for="Alta.Nombre" class="form-label">Nombre *</label><input asp-for="Alta.Nombre" class="form-control" /><span asp-validation-for="Alta.Nombre"></span></div>
<div class="col-md-6"><label asp-for="Alta.PrimerApellido" class="form-label">Primer apellido *</label><input asp-for="Alta.PrimerApellido" class="form-control" /><span asp-validation-for="Alta.PrimerApellido"></span></div>
<div class="col-md-6"><label asp-for="Alta.SegundoApellido" class="form-label">Segundo apellido</label><input asp-for="Alta.SegundoApellido" class="form-control" /><span asp-validation-for="Alta.SegundoApellido"></span></div>
<div class="col-md-6"><label asp-for="Alta.Correo" class="form-label">Correo *</label><input asp-for="Alta.Correo" class="form-control" /><span asp-validation-for="Alta.Correo"></span></div>
<div class="col-md-6"><label asp-for="Alta.Identificacion" class="form-label">Identificación *</label><input asp-for="Alta.Identificacion" class="form-control" /><span asp-validation-for="Alta.Identificacion"></span></div>
<div class="col-md-6"><label asp-for="Alta.NombreRazonSocial" class="form-label">Razón social (persona jurídica)</label><input asp-for="Alta.NombreRazonSocial" class="form-control" /><span asp-validation-for="Alta.NombreRazonSocial"></span></div>
<div class="col-md-6"><label asp-for="Alta.Telefono" class="form-label">Teléfono</label><input asp-for="Alta.Telefono" class="form-control" /><span asp-validation-for="Alta.Telefono"></span></div>
<div class="col-md-6"><label asp-for="Alta.Direccion" class="form-label">Dirección</label><input asp-for="Alta.Direccion" class="form-control" /><span asp-validation-for="Alta.Direccion"></span></div>
<div class="col-12"><div class="alert alert-info">Se asignará exclusivamente el rol Administrador desde el servidor. La cuenta quedará aprobada y recibirá una invitación para establecer su contraseña. No ingrese contraseñas. La empresa debe estar activa.</div></div>}
</div><button class="btn btn-contacto-primary mt-3"><i class="bi bi-check2"></i> @(existe?"Guardar datos":"Registrar e invitar")</button></form></section>
@if(existe){<section class="contactos-panel usuarios-panel"><h2>Acceso · @Model.Usuario!.Estado · @Model.Usuario.EstadoAprobacion</h2><div class="d-flex flex-wrap gap-2">
<button type="button" class="btn @(Model.Usuario.Estado=="Activo"?"btn-outline-danger":"btn-contacto-primary")" disabled="@(Model.Usuario.Estado=="Activo"&&Model.Empresa.Estado=="Activo"&&Model.Empresa.AdministradoresHabilitados<=1)" data-bs-toggle="modal" data-bs-target="#accionAdministrador" data-accion="estado" data-valor="@(Model.Usuario.Estado=="Activo"?"false":"true")" data-descripcion="Cambiar el acceso de @Model.Usuario.Nombre @Model.Usuario.PrimerApellido en @Model.Empresa.RazonSocial.">@(Model.Usuario.Estado=="Activo"?"Desactivar":"Activar")</button>
@if(Model.Usuario.Estado=="Activo"&&Model.Empresa.Estado=="Activo"){<button type="button" class="btn btn-contacto-outline" data-bs-toggle="modal" data-bs-target="#accionAdministrador" data-accion="enlace" data-descripcion="Programar un enlace para que @Model.Usuario.Nombre establezca su propia contraseña."><i class="bi bi-envelope"></i> Enviar enlace</button>}</div>
@if(Model.Empresa.Estado=="Activo"&&Model.Empresa.AdministradoresHabilitados<=1){<p class="text-muted mt-3">La empresa activa debe conservar un administrador habilitado. Registre o active otro antes de desactivar el último.</p>}
<div class="modal fade" id="accionAdministrador" tabindex="-1" aria-labelledby="tituloAccion"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5" id="tituloAccion">Confirmar operación</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div><div class="modal-body"><p id="descripcionAdministrador"></p><p class="text-muted">La operación será registrada en bitácora.</p></div><div class="modal-footer"><button type="button" class="btn btn-contacto-outline" data-bs-dismiss="modal">Cancelar</button><form method="post" asp-page-handler="Accion"><input type="hidden" name="accion" id="accionAdministradorValor" /><input type="hidden" name="activo" id="estadoAdministradorValor" /><button class="btn btn-contacto-primary">Confirmar</button></form></div></div></div></div></section>}
</div>
@section Scripts {<partial name="_ValidationScriptsPartial" /><script src="~/js/registro-campos.js" asp-append-version="true"></script><script src="~/js/usuarios-formulario.js" asp-append-version="true"></script><script src="~/js/plataforma.js" asp-append-version="true"></script>}