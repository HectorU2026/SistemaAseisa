@page "{id:int?}"
@model Web.Pages.Plataforma.EmpresaModel
@{ViewData["Title"]="Empresa";var existente=Model.Datos.IdEmpresa>0;}
<link rel="stylesheet" href="~/css/contactos.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/usuarios.css" asp-append-version="true" />
<div class="contactos-page usuarios-page">
<div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
@if(TempData["Mensaje"] is string mensaje){<div class="alert alert-success" role="status">@mensaje</div>}<div class="contactos-header"><div><div class="contactos-breadcrumb"><a asp-page="Empresas">Empresas</a> / Detalle</div><h1>@(existente?Model.Datos.RazonSocial:"Nueva empresa")</h1></div><a asp-page="Empresas" class="btn btn-contacto-outline">Volver al listado</a></div>
<section class="contactos-panel usuarios-panel"><form method="post" asp-page-handler="Guardar" data-formulario-usuario><div class="row g-3"><div class="col-md-6"><label asp-for="Datos.RazonSocial" class="form-label">Razón social *</label><input asp-for="Datos.RazonSocial" class="form-control" /><span asp-validation-for="Datos.RazonSocial"></span></div>
<div class="col-md-6"><label asp-for="Datos.NombreComercial" class="form-label">Nombre comercial</label><input asp-for="Datos.NombreComercial" class="form-control" /><span asp-validation-for="Datos.NombreComercial"></span></div>
<div class="col-md-6"><label asp-for="Datos.CedulaJuridica" class="form-label">Cédula jurídica *</label><input asp-for="Datos.CedulaJuridica" class="form-control" /><span asp-validation-for="Datos.CedulaJuridica"></span></div>
<div class="col-md-6"><label asp-for="Datos.Correo" class="form-label">Correo</label><input asp-for="Datos.Correo" class="form-control" /><span asp-validation-for="Datos.Correo"></span></div>
<div class="col-md-6"><label asp-for="Datos.Telefono" class="form-label">Teléfono</label><input asp-for="Datos.Telefono" class="form-control" /><span asp-validation-for="Datos.Telefono"></span></div>
<div class="col-md-6"><label asp-for="Datos.Direccion" class="form-label">Dirección</label><input asp-for="Datos.Direccion" class="form-control" /><span asp-validation-for="Datos.Direccion"></span></div>
<div class="col-md-6"><label asp-for="Datos.MonedaBase" class="form-label">Moneda base *</label><input asp-for="Datos.MonedaBase" class="form-control" /><span asp-validation-for="Datos.MonedaBase"></span></div>
</div><button class="btn btn-contacto-primary mt-3"><i class="bi bi-check2"></i> Guardar datos</button></form></section>
@if(existente){<section class="contactos-panel usuarios-panel"><h2>Acceso de la empresa · @Model.Datos.Estado</h2><button type="button" class="btn @(Model.Datos.Estado=="Activo"?"btn-outline-danger":"btn-contacto-primary")" data-bs-toggle="modal" data-bs-target="#estadoEmpresa">@(Model.Datos.Estado=="Activo"?"Desactivar empresa":"Activar empresa")</button>
<div class="modal fade" id="estadoEmpresa" tabindex="-1" aria-labelledby="tituloEstadoEmpresa"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5" id="tituloEstadoEmpresa">Confirmar cambio de acceso</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div><div class="modal-body">@Model.Datos.RazonSocial. Al desactivar la empresa todos sus usuarios perderán acceso en la siguiente revalidación. Se conservarán los datos y operaciones.</div><div class="modal-footer"><button type="button" class="btn btn-contacto-outline" data-bs-dismiss="modal">Cancelar</button><form method="post" asp-page-handler="Estado"><input type="hidden" name="activo" value="@(Model.Datos.Estado=="Activo"?"false":"true")" /><button class="btn btn-outline-danger">Confirmar</button></form></div></div></div></div></section>
<section class="contactos-panel usuarios-panel"><h2>Administradores · @Model.Datos.AdministradoresHabilitados habilitado(s)</h2>@if(Model.Datos.Estado=="Activo"){<a asp-page="Administrador" asp-route-empresa="@Model.Datos.IdEmpresa" class="btn btn-contacto-primary"><i class="bi bi-person-plus"></i> Nuevo administrador</a>}
<ul class="list-group mt-3">@foreach(var u in Model.Vista.Administradores){<li class="list-group-item d-flex justify-content-between"><span>@u.Nombre @u.PrimerApellido · @u.Estado</span><a asp-page="Administrador" asp-route-empresa="@u.IdEmpresa" asp-route-id="@u.IdUsuario" class="btn btn-contacto-outline">Administrar</a></li>}</ul></section>}
</div>
@section Scripts {<partial name="_ValidationScriptsPartial" /><script src="~/js/registro-campos.js" asp-append-version="true"></script><script src="~/js/usuarios-formulario.js" asp-append-version="true"></script>}